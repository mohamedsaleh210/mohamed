# انسخ الملف ده لـ .env وغيّر القيم.
# على Hostinger أو Railway، حطها من لوحة التحكم بدل الملف.

NODE_ENV=production
PORT=3000

# ⚠️ لازم يتغيّر. ولّد واحد بالأمر ده:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-before-going-live

# سر مستقل للوحة سند المركزية (لا تستخدم نفس سر الموقع).
PLATFORM_SESSION_SECRET=change-me-to-another-long-random-value

# بيانات مالك المنصة مطلوبة عند أول تشغيل إنتاجي فقط.
PLATFORM_ADMIN_USERNAME=adam
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
PLATFORM_COOKIE_SECURE=false

# مسار لوحة الإدارة. غيّره لحاجة مش متوقّعة.
ADMIN_PATH=/office-panel

# ⚠️ لازم يكون بره مجلد المشروع، وإلا الداتا هتضيع مع أول deploy.
# على Hostinger: /home/<اسم المستخدم>/sanad-data
DATA_DIR=/home/username/sanad-data

# قاعدة الاشتراكات والباقات وملفات الشركات العامة؛ يجب أن تكون خارج المشروع.
PLATFORM_DATA_DIR=/home/username/sanad-platform-data

# منفذ لوحة المنصة المركزية عند تشغيلها كخدمة منفصلة.
PLATFORM_PORT=4000

# اتركها 0 في الإنتاج. القيمة 1 تنشئ بيانات محاكاة فقط في قاعدة فارغة.
SEED_DEMO=0

# فعّلها فقط إذا كانت الاستضافة لا تسمح بتشغيل مساحات الشركات كعمليات فرعية.
DISABLE_TENANT_LAUNCHER=0

# PORT: متحطهوش على Hostinger أو Railway — بيتحدد تلقائياً.
