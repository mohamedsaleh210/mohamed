<%pageTitle='أجندة الأعمال'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'أجندة الأعمال'}]})%>
<div class="page-head"><h1>أجندة الأعمال</h1><p class="sub">المهام والمواعيد والطلبات والقضايا والمشاوير في مكان واحد.</p></div>
<%
  const today = new Date().toISOString().slice(0,10);
  const todayCount = events.filter(e => String(e.starts_at).slice(0,10) === today).length;
  const urgentCount = events.filter(e => e.priority === 'urgent' && e.status !== 'completed' && e.status !== 'cancelled').length;
  const doneCount = events.filter(e => e.status === 'completed').length;
%>
<div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-brass" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><span class="k">إجمالي أعمال الشهر</span><b class="v"><span data-count-to="<%=events.length%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-calendar"/></svg></i><div><span class="k">اليوم</span><b class="v"><span data-count-to="<%=todayCount%>">0</span></b></div></div><div class="stat warn icon-stat"><i class="stat-ico ic-warn" aria-hidden="true"><svg><use href="/images/icons.svg#i-alert-triangle"/></svg></i><div><span class="k">عاجل ولم يكتمل</span><b class="v"><span data-count-to="<%=urgentCount%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-check-circle"/></svg></i><div><span class="k">مكتمل</span><b class="v"><span data-count-to="<%=doneCount%>">0</span></b></div></div></div>
<form class="toolbar" method="get"><input type="month" name="month" value="<%=month%>"><%if(isAdmin){%><select name="user_id"><option value="">جميع الموظفين</option><%staff.forEach(u=>{%><option value="<%=u.id%>" <%=u.id===userId?'selected':''%>><%=u.display_name%></option><%})%></select><%}%><button class="btn">عرض</button><%if(can('agenda.export')){%><a class="btn ghost" href="<%=adminPath%>/agenda/export.csv?month=<%=month%><%=userId?'&user_id='+userId:''%>">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/agenda/print?month=<%=month%><%=userId?'&user_id='+userId:''%>">PDF / طباعة</a><%}%><%if(can('agenda.manage')){%><button class="btn brass" type="button" onclick="document.getElementById('addAgenda').showModal()">+ موعد جديد</button><%}%></form>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-calendar"/></svg> أعمال <%=month%></h3><span class="chip spacer"><%=events.length%></span></div><div class="panel-body flush"><%if(!events.length){%><div class="empty"><span class="big"><svg aria-hidden="true"><use href="/images/icons.svg#i-calendar"/></svg></span><p>لا توجد أعمال في هذا الشهر.</p></div><%}else{%><table class="tbl"><thead><tr><th>الموعد</th><th>العمل</th><th>النوع</th><th>المسؤولون</th><th>مرتبط بـ</th><th>الحالة</th></tr></thead><tbody><%events.forEach(e=>{%><tr><td class="num"><%=String(e.starts_at).slice(0,16)%><%if(e.ends_at){%><br><small>إلى <%=String(e.ends_at).slice(0,16)%></small><%}%></td><td><b><%=e.title%></b><%if(e.priority==='urgent'){%><span class="flag">عاجل</span><%}%></td><td><%=({manual:'يدوي',request:'طلب',case:'قضية',trip:'مشوار'})[e.source]||e.event_type%></td><td><%=e.assignee||'—'%></td><td><%= [e.client_name,e.company_name,e.request_ref].filter(Boolean).join(' · ')||'—' %></td><td><%if(e.source==='manual'){%><form method="post" action="<%=adminPath%>/agenda/<%=e.id%>/status"><%-csrfField%><select name="status" onchange="this.form.submit()"><%[['pending','لم يبدأ'],['in_progress','جاري'],['waiting','انتظار'],['completed','مكتمل'],['cancelled','ملغي']].forEach(x=>{%><option value="<%=x[0]%>" <%=e.status===x[0]?'selected':''%>><%=x[1]%></option><%})%></select></form><%}else{%><span class="chip <%=({completed:'ok',cancelled:'danger',in_progress:'brass',waiting:'warn'})[e.status]||''%>"><%=({pending:'لم يبدأ',in_progress:'جاري',waiting:'انتظار',completed:'مكتمل',cancelled:'ملغي'})[e.status]||e.status%></span><%}%></td></tr><%})%></tbody></table><%}%></div></div>
<dialog class="sub-dialog" id="addAgenda"><form method="dialog"><button class="dialog-close" aria-label="إغلاق"><svg width="16" height="16" aria-hidden="true"><use href="/images/icons.svg#i-x"/></svg></button></form><h2><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إضافة عمل أو موعد</h2><form method="post" action="<%=adminPath%>/agenda/new"><%-csrfField%><div class="field"><label>العنوان</label><input type="text" name="title" required></div><div class="two-col"><div class="field"><label>النوع</label><select name="event_type"><option value="task">مهمة</option><option value="meeting">اجتماع</option><option value="deadline">موعد تسليم</option><option value="renewal">تجديد</option><option value="payment">دفعة</option></select></div><div class="field"><label>الأولوية</label><select name="priority"><option value="normal">عادية</option><option value="high">مرتفعة</option><option value="urgent">عاجلة</option></select></div></div><div class="two-col"><div class="field"><label>البداية</label><input type="date" name="starts_at" required><details class="picker-box"><summary>اختيار الوقت (اختياري)</summary><input type="time" name="start_time"><button type="button" class="btn sm brass" onclick="this.closest('details').removeAttribute('open')">موافق</button></details></div><div class="field"><label>النهاية (اختيارية)</label><input type="date" name="ends_at"><details class="picker-box"><summary>اختيار الوقت (اختياري)</summary><input type="time" name="end_time"><button type="button" class="btn sm brass" onclick="this.closest('details').removeAttribute('open')">موافق</button></details></div></div><div class="field"><label>المسؤولون — يمكن اختيار أكثر من شخص</label><details class="picker-box"><summary>اختر المسؤولين</summary><div class="check-grid"><%staff.forEach(u=>{%><label class="check"><input type="checkbox" name="assigned_user_ids" value="<%=u.id%>"> <%=u.display_name%></label><%})%></div><button type="button" class="btn brass" onclick="this.closest('details').removeAttribute('open')">موافق وإغلاق الاختيار</button></details></div><div class="two-col"><div class="field"><label>ربط بعميل (اختياري)</label><select name="client_id"><option value="">بدون</option><%clients.forEach(c=>{%><option value="<%=c.id%>"><%=c.full_name%> · <%=c.phone||''%></option><%})%></select></div><div class="field"><label>ربط بشركة (اختياري)</label><select name="company_id"><option value="">بدون</option><%companies.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></div></div><div class="field"><label>ربط بطلب (اختياري)</label><select name="request_id"><option value="">بدون</option><%requestsList.forEach(r=>{%><option value="<%=r.id%>"><%=r.ref%> · <%=r.name%></option><%})%></select></div><div class="field"><label>الموقع</label><input type="text" name="location"></div><div class="field"><label>ملاحظات</label><textarea name="notes"></textarea></div><label class="check"><input type="checkbox" name="client_visible" value="1"> يظهر للعميل</label><button class="btn brass block">حفظ وإضافة للأجندة</button></form></dialog>
<%-include('../partials/admin_foot')%>
