<%const bookingStatus={unassigned:'يحتاج تعيين',confirmed:'مؤكد',completed:'مغلق',cancelled:'ملغى'};const BOOKING_COLOR={unassigned:'#d98a3d',confirmed:'#3a9d6b',completed:'#6b7785',cancelled:'#c15450'};%><%pageTitle='تفاصيل الموعد'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'المواعيد والاستشارات',href:adminPath+'/appointments'},{label:item.ref}]})%>
<div class="page-head-row"><div class="page-head"><h1><%=item.ref%></h1><p class="sub"><span class="num"><%=slot.starts_at%> — <%=slot.ends_at%></span> UTC<%if(slot.location){%> · <%=slot.location%><%}%></p></div><span class="chip" style="background:<%=BOOKING_COLOR[item.status]||'#888'%>;color:#fff"><%=bookingStatus[item.status]||item.status%></span></div>

<div class="btn-row" style="margin-bottom:16px"><a class="btn ghost" href="<%=adminPath%>/agenda?month=<%=slot.starts_at.slice(0,7)%>"><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-calendar"/></svg> التقويم</a><%if(manage){%><a class="btn ghost" href="<%=adminPath%>/requests/<%=item.request_id%>"><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-list"/></svg> الطلب والمرفقات والمالية</a><%}%></div>

<%if(item.notes){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-info"/></svg> ملاحظات</h3></div><div class="panel-body"><p style="margin:0"><%=item.notes%></p></div></div><%}%>

<%if(manage&&!['cancelled','completed'].includes(item.status)){%>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-edit"/></svg> تحديث الحجز</h3></div>
<form class="panel-body form-grid" method="post"><%-csrfField%><input type="hidden" name="version" value="<%=item.version%>"><label>الإجراء<select name="action"><option value="assign">تعيين / إعادة تعيين موظف</option><option value="reschedule">إعادة الجدولة</option><option value="edit">تعديل الملاحظات</option><option value="cancel">إلغاء</option><option value="complete">إغلاق الموعد</option></select></label><label>الموظف<select name="user_id"><%staff.forEach(u=>{%><option value="<%=u.id%>" <%=u.id===item.assigned_user_id?'selected':''%>><%=u.display_name%></option><%})%></select></label><label>موعد جديد<select name="slot_id"><%slots.forEach(s=>{%><option value="<%=s.id%>"><%=s.starts_at%> — <%=s.ends_at%></option><%})%></select></label><label class="wide">تفاصيل<textarea name="notes"><%=item.notes%></textarea></label><label class="wide">سبب العملية<input type="text" name="reason" required maxlength="500"></label><button class="btn brass">حفظ العملية</button></form>
</div>
<%}%>

<%if(manage){%>
<div class="two-col wide">
  <div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-building"/></svg> ربط الشركة والفرع</h3></div>
    <form class="panel-body" method="post" action="<%=adminPath%>/appointments/<%=item.id%>/company"><%-csrfField%><label>الشركة<select name="company_id"><%companies.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label>الفرع<select name="branch_id"><option value="">بدون فرع</option><%branches.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%> / <%=c.company_id%></option><%})%></select></label><button class="btn">ربط الشركة والفرع</button></form>
  </div>
  <%if(can('money.fees')){%>
  <div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-receipt"/></svg> الفاتورة</h3></div>
    <form class="panel-body" method="post" action="<%=adminPath%>/appointments/<%=item.id%>/invoice"><%-csrfField%><button class="btn block">إصدار / عرض فاتورة من أتعاب الطلب</button></form>
  </div>
  <%}%>
</div>
<%}%>

<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-clock"/></svg> سجل الموعد</h3></div><div class="panel-body"><ul class="timeline">
<%history.forEach(h=>{%><li><div class="what"><div class="m"><%=h.action%><%if(h.reason){%> — <%=h.reason%><%}%></div><div class="meta"><span class="num"><%=h.created_at%></span><%if(h.action==='assign'){const before=h.before_json?JSON.parse(h.before_json):{},after=JSON.parse(h.after_json);%> — الموظف السابق: <%=staff.find(u=>u.id===before.assigned_user_id)?.display_name||before.assigned_user_id||'غير معين'%> — الموظف الجديد: <%=staff.find(u=>u.id===after.assigned_user_id)?.display_name||after.assigned_user_id%><%}%></div></div></li><%})%>
<%if(!history.length){%><li class="what"><div class="m" style="color:var(--muted)">لا يوجد سجل بعد.</div></li><%}%>
</ul></div></div>
<%-include('../partials/admin_foot')%>
