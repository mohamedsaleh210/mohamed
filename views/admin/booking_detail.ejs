<%const bookingStatus={unassigned:'يحتاج تعيين',confirmed:'مؤكد',completed:'مغلق',cancelled:'ملغى'};%><%pageTitle='تفاصيل الموعد'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><h1><%=item.ref%></h1><p><%=slot.starts_at%> — <%=slot.ends_at%> UTC — <%=slot.location%></p><p><%=item.notes%></p><p>الحالة: <%=bookingStatus[item.status]||item.status%></p><a class="btn" href="<%=adminPath%>/agenda?month=<%=slot.starts_at.slice(0,7)%>">التقويم</a><%if(manage){%><a class="btn" href="<%=adminPath%>/requests/<%=item.request_id%>">الطلب والمرفقات والمالية</a><%}%><%if(manage&&!['cancelled','completed'].includes(item.status)){%><form class="panel form-grid" method="post"><%-csrfField%><input type="hidden" name="version" value="<%=item.version%>"><label>الإجراء<select name="action"><option value="assign">تعيين / إعادة تعيين موظف</option><option value="reschedule">إعادة الجدولة</option><option value="edit">تعديل الملاحظات</option><option value="cancel">إلغاء</option><option value="complete">إغلاق الموعد</option></select></label><label>الموظف<select name="user_id"><%staff.forEach(u=>{%><option value="<%=u.id%>" <%=u.id===item.assigned_user_id?'selected':''%>><%=u.display_name%></option><%})%></select></label><label>موعد جديد<select name="slot_id"><%slots.forEach(s=>{%><option value="<%=s.id%>"><%=s.starts_at%> — <%=s.ends_at%></option><%})%></select></label><label>تفاصيل<textarea name="notes"><%=item.notes%></textarea></label><label>سبب العملية<input type="text" name="reason" required maxlength="500"></label><button class="btn brass">حفظ العملية</button></form><%}%><%if(manage){%><form method="post" action="<%=adminPath%>/appointments/<%=item.id%>/company"><%-csrfField%><label>الشركة<select name="company_id"><%companies.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label>الفرع<select name="branch_id"><option value="">بدون فرع</option><%branches.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%> / <%=c.company_id%></option><%})%></select></label><button class="btn">ربط الشركة والفرع</button></form><%if(can('money.fees')){%><form method="post" action="<%=adminPath%>/appointments/<%=item.id%>/invoice"><%-csrfField%><button class="btn">إصدار / عرض فاتورة من أتعاب الطلب</button></form><%}%><%}%><h2>سجل الموعد</h2><%history.forEach(h=>{%><p><%=h.created_at%> — <%=h.action%> — <%=h.reason%><%if(h.action==='assign'){const before=h.before_json?JSON.parse(h.before_json):{},after=JSON.parse(h.after_json);%> — الموظف السابق: <%=staff.find(u=>u.id===before.assigned_user_id)?.display_name||before.assigned_user_id||'غير معين'%> — الموظف الجديد: <%=staff.find(u=>u.id===after.assigned_user_id)?.display_name||after.assigned_user_id%><%}%></p><%})%><%-include('../partials/admin_foot')%>
