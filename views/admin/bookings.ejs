<%const L={unassigned:'يحتاج تعيين',confirmed:'مؤكد',completed:'مغلق',cancelled:'ملغى'};%><%pageTitle='المواعيد والاستشارات'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%>
<div class="page-head-row"><div class="page-head"><h1>المواعيد والاستشارات</h1><p class="sub">إدارة الحجوزات، التعيين، التقويم، والأوقات المتاحة.</p></div><div class="btn-row"><%if(manage){%><a class="btn brass" href="<%=adminPath%>/appointments?tab=slots">+ فتح مواعيد للحجز</a><%}%><%if(can('bookings.create')){%><a class="btn" href="<%=adminPath%>/appointments/new">إنشاء حجز لعميل</a><%}%><%if(can('agenda.export')){%><a class="btn ghost" href="<%=adminPath%>/appointments/export.csv">تصدير CSV</a><%}%></div></div>
<div class="stat-grid"><div class="stat warn icon-stat"><i class="stat-ico ic-warn">!</i><div><span class="k">تحتاج تعيين</span><b class="v"><%=counts.unassigned||0%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok">✓</i><div><span class="k">مؤكدة</span><b class="v"><%=counts.confirmed||0%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info">◷</i><div><span class="k">اليوم</span><b class="v"><%=counts.today||0%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-brass">▤</i><div><span class="k">مكتملة</span><b class="v"><%=counts.completed||0%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger">✕</i><div><span class="k">ملغاة</span><b class="v"><%=counts.cancelled||0%></b></div></div></div>
<div class="tabs"><a class="<%=tab==='bookings'?'active':''%>" href="<%=adminPath%>/appointments?tab=bookings">الحجوزات</a><a class="<%=tab==='unassigned'?'active':''%>" href="<%=adminPath%>/appointments?tab=unassigned">تحتاج تعيين</a><a href="<%=adminPath%>/agenda">التقويم</a><a class="<%=tab==='slots'?'active':''%>" href="<%=adminPath%>/appointments?tab=slots">فتح المواعيد المتاحة</a><a class="<%=tab==='settings'?'active':''%>" href="<%=adminPath%>/appointments?tab=settings">إعدادات الحجز</a></div>
<%if(tab==='bookings'||tab==='unassigned'){%><form method="get" class="panel panel-body form-grid"><input type="hidden" name="tab" value="<%=tab%>"><label>بحث<input type="search" name="q" value="<%=query.q||''%>" placeholder="المرجع أو العميل أو رقم الموبايل"></label><label>الحالة<select name="status"><option value="">الكل</option><%Object.entries(L).forEach(([k,v])=>{%><option value="<%=k%>" <%=query.status===k?'selected':''%>><%=v%></option><%})%></select></label><label>النوع<select name="kind"><option value="">الكل</option><option value="appointment">موعد</option><option value="consultation">استشارة</option></select></label><button class="btn">بحث</button></form>
<div class="panel"><div class="panel-body flush"><table class="tbl"><thead><tr><th>المرجع</th><th>الموعد</th><th>العميل</th><th>النوع</th><th>الموظف</th><th>الحالة</th><th></th></tr></thead><tbody><%items.forEach(i=>{%><tr><td><a href="<%=adminPath%>/appointments/<%=i.id%>"><b><%=i.ref%></b></a></td><td><%=i.starts_at%></td><td><%=i.full_name%><br><small><%=i.phone||''%></small></td><td><%=i.kind==='consultation'?'استشارة':'موعد'%></td><td><%=i.display_name||'—'%></td><td><span class="chip"><%=L[i.status]||i.status%></span></td><td><%if(manage&&i.status==='unassigned'){%><form method="post" action="<%=adminPath%>/appointments/<%=i.id%>/assign" class="mini-form"><%-csrfField%><select name="user_id" required><option value="">اختر موظفًا</option><%staff.forEach(u=>{%><option value="<%=u.id%>"><%=u.display_name%></option><%})%></select><button class="btn sm brass">تعيين</button></form><%}%></td></tr><%})%></tbody></table><%if(!items.length){%><div class="empty"><p>لا توجد حجوزات حتى الآن.</p><%if(manage){%><a class="btn brass" href="<%=adminPath%>/appointments?tab=slots">فتح أول موعد متاح للحجز</a><%}%></div><%}%></div></div><%}%>
<%if(tab==='slots'&&manage){%><div class="panel"><div class="panel-head"><div><h3>فتح موعد جديد للحجز</h3><p class="sub">الوقت الذي تضيفه هنا يظهر فورًا للزائر داخل صفحة «احجز موعد» ما دام استقبال الحجوزات مفعّلًا.</p></div></div><form method="post" action="<%=adminPath%>/appointments/slots" class="panel-body form-grid"><%-csrfField%><label>بداية الموعد<input type="datetime-local" name="starts_at" required></label><label>نهاية الموعد<input type="datetime-local" name="ends_at" required></label><label>مكان أو طريقة الموعد<input type="text" name="location" maxlength="200" placeholder="مقر المكتب أو أونلاين"></label><button class="btn brass">فتح الموعد للحجز</button></form><div class="panel-head"><h3>المواعيد المفتوحة حاليًا</h3></div><div class="panel-body"><%slots.forEach(s=>{%><form method="post" action="<%=adminPath%>/appointments/slots/<%=s.id%>/close" class="mini-form"><%-csrfField%><span><%=s.starts_at%> — <%=s.ends_at%> · <%=s.location||'لم يحدد المكان'%></span><button class="btn ghost sm">إيقاف الحجز</button></form><%})%><%if(!slots.length){%><div class="empty"><p>لا توجد مواعيد مفتوحة. استخدم النموذج بالأعلى لفتح أول موعد.</p></div><%}%></div></div><%}%>
<%if(tab==='settings'&&manage){%><div class="panel"><div class="panel-head"><h3>إعدادات استقبال الحجز</h3></div><form class="panel-body" method="post" action="<%=adminPath%>/appointments/settings"><%-csrfField%><label><input type="checkbox" name="enabled" <%=enabled?'checked':''%>> استقبال الحجوزات العامة</label><button class="btn">حفظ</button></form></div><%}%><%-include('../partials/admin_foot')%>
