<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>تقرير القضية <%=c.file_no%></title><style>body{font-family:Arial,sans-serif;color:#102f3a;margin:35px;line-height:1.7}h1,h2{margin:0 0 12px}header{border-bottom:3px solid #cda646;margin-bottom:24px;padding-bottom:15px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.box,table{border:1px solid #ccd5d7;border-radius:8px;margin:14px 0;padding:12px}table{width:100%;border-collapse:collapse}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:right}th{background:#f2f4f3}.actions{margin-bottom:20px}@media print{.actions{display:none}body{margin:10mm}}</style></head><body>
<div class="actions"><button onclick="window.print()">طباعة / حفظ PDF</button></div><header><h1>تقرير ملف القضية</h1><b><%=c.file_no%></b> · <%=c.title%></header>
<h2>بيانات العميل</h2><div class="grid box"><div><b>الاسم:</b> <%=client?.full_name||c.client_name||'—'%></div><div><b>الهاتف:</b> <%=client?.phone||c.phone||'—'%></div><div><b>البريد:</b> <%=client?.email||c.email||'—'%></div><div><b>رقم الطلب:</b> <%=c.request_ref%></div></div>
<h2>بيانات القضية</h2><div class="grid box"><div><b>رقم القضية:</b> <%=c.case_number||'—'%></div><div><b>السنة القضائية:</b> <%=c.judicial_year||'—'%></div><div><b>المحكمة:</b> <%=c.court||'—'%></div><div><b>الدائرة:</b> <%=c.circuit||'—'%></div><div><b>الخصم:</b> <%=c.opposing_party||'—'%></div><div><b>الحالة:</b> <%=STATUS[c.status]||c.status%></div><div><b>فتح الملف:</b> <%=c.opened_on||'—'%></div><div><b>الجلسة القادمة:</b> <%=c.next_hearing||'—'%></div></div>
<h2>فريق القضية</h2><p><%=assignees.map(x=>x.display_name+(x.assignment_role?' — '+x.assignment_role:'')).join('، ')||'—'%></p>
<h2>أطراف القضية</h2><table><tr><th>الاسم</th><th>الصفة</th><th>الهاتف</th></tr><%parties.forEach(x=>{%><tr><td><%=x.name%></td><td><%=x.capacity||x.party_type%></td><td><%=x.phone||'—'%></td></tr><%})%></table>
<h2>الجلسات والقرارات</h2><table><tr><th>التاريخ</th><th>الغرض</th><th>القرار</th><th>الجلسة التالية</th></tr><%hearings.forEach(x=>{%><tr><td><%=x.hearing_on%></td><td><%=x.purpose%></td><td><%=x.decision||'—'%></td><td><%=x.next_hearing||'—'%></td></tr><%})%></table>
<h2>الإجراءات والمذكرات</h2><table><tr><th>التاريخ</th><th>النوع</th><th>الإجراء</th><th>التفاصيل</th></tr><%events.forEach(x=>{%><tr><td><%=x.event_on||x.created_at%></td><td><%=x.event_type%></td><td><%=x.title%></td><td><%=x.details||'—'%></td></tr><%})%></table>
<h2>الأعمال</h2><table><tr><th>العمل</th><th>المسؤول</th><th>الموعد</th><th>الحالة</th></tr><%tasks.forEach(x=>{%><tr><td><%=x.title%></td><td><%=x.assignee||'—'%></td><td><%=x.due_on||'—'%></td><td><%=x.status%></td></tr><%})%></table>
<p><b>الملخص الداخلي:</b> <%=c.summary||'—'%></p></body></html>
