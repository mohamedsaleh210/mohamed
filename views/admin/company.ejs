<% pageTitle=company.name %><%- include('../partials/admin_head') %><%- include('../partials/admin_nav') %>
<%- include('../partials/crumbs',{crumbs:[{label:'الشركات',href:adminPath+'/clients/companies'},{label:company.name}]}) %>
<div class="page-head-row"><div class="page-head"><h1><%= company.name %></h1><p class="sub"><%= company.registration_no?'سجل '+company.registration_no+' · ':'' %><%= company.contact_name||'' %></p></div><div class="btn-row"><a class="btn ghost" href="<%= adminPath %>/clients/companies/<%= company.id %>/print" target="_blank">طباعة / PDF</a></div></div>
<div class="stat-grid" style="margin-bottom:14px">
  <div class="stat icon-stat"><i class="stat-ico ic-brass" aria-hidden="true"><svg><use href="/images/icons.svg#i-building"/></svg></i><div><div class="k">الفروع</div><div class="v"><span data-count-to="<%= branches.length %>">0</span></div></div></div>
  <div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><div class="k">الطلبات</div><div class="v"><span data-count-to="<%= requests.length %>">0</span></div></div></div>
  <div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-users"/></svg></i><div><div class="k">عملاء ومسؤولو التواصل</div><div class="v"><span data-count-to="<%= contacts.length %>">0</span></div></div></div>
</div>
<div class="two-col wide"><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-building"/></svg> الفروع</h3><span class="chip spacer"><%= branches.length %></span></div><div class="panel-body flush">
<% if(branches.length){ %><table class="tbl"><thead><tr><th>الفرع</th><th>المدير</th><th>العنوان</th><th>الطلبات</th><th></th></tr></thead><tbody><% branches.forEach(b=>{ %><tr><td><b><%= b.name %></b><br><small><%= b.code||'' %></small></td><td><%= b.manager||'—' %></td><td><%= b.address||'—' %></td><td><%= b.request_count %></td><td><a class="btn brass sm" href="<%= adminPath %>/requests/new?company=<%= company.id %>&branch=<%= b.id %>">+ طلب</a> <a class="btn ghost sm" href="<%= adminPath %>/clients/companies/<%= company.id %>/branches/<%= b.id %>/print" target="_blank">طباعة</a></td></tr><% }) %></tbody></table><% }else{%><div class="empty"><p>أضف فرعًا أولًا؛ طلب الشركة لا يُفتح دون فرع.</p></div><%}%></div></div>
<% if(can('clients.edit')){ %><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إضافة فرع</h3></div><form class="panel-body" method="post" action="<%= adminPath %>/clients/companies/<%= company.id %>/branches"><%- csrfField %><div class="field req"><label>اسم الفرع</label><input type="text" name="name" required></div><div class="field"><label>كود الفرع</label><input type="text" name="code"></div><div class="field"><label>مدير الفرع</label><input type="text" name="manager"></div><div class="field"><label>الهاتف</label><input type="text" name="phone"></div><div class="field"><label>البريد</label><input type="email" name="email"></div><div class="field"><label>العنوان</label><input type="text" name="address"></div><div class="field"><label>ملاحظات</label><textarea name="notes"></textarea></div><button class="btn brass block">إضافة الفرع</button></form></div><%}%></div>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-list"/></svg> طلبات الشركة</h3><span class="chip spacer"><%= requests.length %></span></div><div class="panel-body flush"><% if(requests.length){%><table class="tbl"><thead><tr><th>الطلب</th><th>الفرع</th><th>الخدمة</th><th>الحالة</th><th></th></tr></thead><tbody><% requests.forEach(r=>{const s=STATUS[r.status]||{ar:r.status,color:'#777'};%><tr><td class="num"><%= r.ref %></td><td><%= r.branch_name %></td><td><%= (r.service_label||'—').split(' / ')[0] %></td><td><span class="badge" style="background:<%=s.color%>"><%=s.ar%></span></td><td><a class="btn ghost sm" href="<%=adminPath%>/requests/<%=r.id%>">فتح</a></td></tr><%})%></tbody></table><%}else{%><div class="empty"><p>لا توجد طلبات للشركة.</p></div><%}%></div></div>
<%if(can('clients.edit')){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-file"/></svg> الخدمات الخاصة بالشركة</h3><span class="chip spacer"><%=services.filter(s=>s.selected).length%> مختارة</span></div><form class="panel-body" method="post" action="<%=adminPath%>/clients/companies/<%=company.id%>/services"><%-csrfField%><div class="check-grid"><%services.forEach(s=>{%><label class="check"><input type="checkbox" name="service_ids" value="<%=s.id%>" <%=s.selected?'checked':''%>> <%=s.title_ar%></label><%})%></div><button class="btn brass" style="margin-top:14px">حفظ الخدمات</button></form></div><%}%>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-users"/></svg> عملاء ومسؤولو الشركة</h3><span class="chip spacer"><%=contacts.length%></span></div><div class="panel-body flush"><%if(contacts.length){%><table class="tbl"><thead><tr><th>الاسم</th><th>الصفة</th><th>الفرع</th><th>التواصل</th></tr></thead><tbody><%contacts.forEach(c=>{%><tr><td><b><%=c.full_name%></b></td><td><%=c.job_title||'—'%></td><td><%=c.branch_name||'كل الشركة'%></td><td><span class="num"><%=c.phone||''%></span><br><small><%=c.email||''%></small></td></tr><%})%></tbody></table><%}else{%><div class="empty"><p>لم يتم تسجيل عملاء أو مسؤولي اتصال للشركة.</p></div><%}%></div></div>
<%if(can('clients.edit')){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إضافة عميل أو مسؤول اتصال للشركة</h3></div><form class="panel-body legal-form" method="post" action="<%=adminPath%>/clients/companies/<%=company.id%>/contacts"><%-csrfField%><div class="two-col"><div class="field req"><label>الاسم</label><input type="text" name="full_name" required></div><div class="field"><label>الصفة أو المسمى</label><input type="text" name="job_title" placeholder="مدير الفرع، مسؤول قانوني..."></div></div><div class="two-col"><div class="field"><label>رقم الموبايل</label><input type="text" name="phone"></div><div class="field"><label>البريد</label><input type="email" name="email"></div></div><div class="field"><label>الفرع (اختياري)</label><select name="branch_id"><option value="">كل الشركة</option><%branches.forEach(b=>{%><option value="<%=b.id%>"><%=b.name%></option><%})%></select></div><div class="field"><label>ملاحظات</label><textarea name="notes"></textarea></div><button class="btn brass">إضافة العميل</button></form></div><%}%>
<%- include('../partials/admin_foot') %>
