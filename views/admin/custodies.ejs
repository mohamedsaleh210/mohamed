<% pageTitle='عهد الموظفين' %><%- include('../partials/admin_head') %><%- include('../partials/admin_nav') %>
<%- include('../partials/crumbs',{crumbs:[{label:'المصاريف',href:adminPath+'/expenses'},{label:'عهد الموظفين'}]}) %>
<% const money=n=>(n||0).toLocaleString('en-US',{maximumFractionDigits:2}); const total=(k)=>employees.reduce((n,x)=>n+(x[k]||0),0); %>
<div class="page-head-row"><div class="page-head"><h1>عهد الموظفين</h1><p class="sub">العهد المستلمة، ما صُرف منها على الطلبات، والرصيد المتبقي مع كل موظف.</p></div><% if(can('expenses.export')) { %><a class="btn ghost" href="<%=adminPath%>/expenses/custodies/export.csv">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/expenses/custodies/print">PDF / طباعة</a><% } %><a class="btn ghost" href="<%= adminPath %>/expenses">المصاريف</a></div>
<% if(msg){ %><div class="alert ok"><span><%= msg==='issued'?'تم تسليم العهدة.':msg==='returned'?'تم تسجيل المبلغ المرتجع.':'تم إلغاء العهدة.' %></span></div><% } %>
<% if(err){ %><div class="alert err"><span><%= err==='return'?'المبلغ المرتجع أكبر من الرصيد أو البيانات غير صحيحة.':err==='void'?'لا يمكن إلغاء عهدة استُخدمت أو لها مرتجع.':err==='treasury'?'رصيد الخزنة غير كافٍ لصرف هذه العهدة.':'راجع بيانات العهدة.' %></span></div><% } %>
<div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">العهد المستلمة</span><b class="v num"><span data-count-to="<%= total('received') %>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger" aria-hidden="true"><svg style="transform:rotate(180deg)"><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">مصروف من العهد</span><b class="v num"><span data-count-to="<%= total('spent') %>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-refresh"/></svg></i><div><span class="k">مرتجع للمكتب</span><b class="v num"><span data-count-to="<%= total('returned') %>">0</span></b></div></div><div class="stat warn icon-stat"><i class="stat-ico ic-warn" aria-hidden="true"><svg><use href="/images/icons.svg#i-clock"/></svg></i><div><span class="k">متبقي مع الموظفين</span><b class="v num"><span data-count-to="<%= total('remaining') %>">0</span></b></div></div></div>

<div class="two-col wide"><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> تسليم عهدة جديدة</h3></div><form method="post" action="<%= adminPath %>/expenses/custodies/new" class="panel-body"><%- csrfField %><div class="field req"><label>الموظف</label><select name="user_id" required><option value="">اختر الموظف</option><% staff.forEach(u=>{ %><option value="<%= u.id %>"><%= u.display_name %></option><% }) %></select></div><div class="field req"><label>الخزنة</label><select name="treasury_id" required><%treasuries.forEach(t=>{%><option value="<%=t.id%>"><%=t.name%> — رصيد <%=money(t.balance)%></option><%})%></select></div><div class="two-col"><div class="field req"><label>المبلغ</label><input type="number" name="amount" min="0.01" step="0.01" required></div><div class="field req"><label>تاريخ التسليم</label><input type="date" name="issued_on" value="<%= new Date().toISOString().slice(0,10) %>" required></div></div><div class="field req"><label>نوع العهدة</label><select name="custody_type"><option value="operational">مصروفات تشغيلية</option><option value="fees">رسوم</option></select></div><div class="field req"><label>الغرض من العهدة</label><input type="text" name="purpose" required placeholder="مثال: رسوم ومشاوير طلبات الأسبوع"></div><div class="field"><label>المرجع أو رقم السند</label><input type="text" name="reference"></div><button class="btn brass block">تسجيل تسليم العهدة وخصمها من الخزنة</button></form></div>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-users"/></svg> كشف حسب الموظف</h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الموظف</th><th>استلم</th><th>صرف</th><th>مرتجع</th><th>المتبقي</th></tr></thead><tbody><% employees.forEach(e=>{ %><tr><td><a href="<%= adminPath %>/users/<%= e.id %>#custody"><b><%= e.display_name %></b></a></td><td class="num"><%= money(e.received) %></td><td class="num"><%= money(e.spent) %></td><td class="num"><%= money(e.returned) %></td><td><b class="num" style="color:<%= e.remaining>0?'var(--danger)':'var(--ok)' %>"><%= money(e.remaining) %></b></td></tr><% }) %></tbody></table><% if(!employees.length){ %><div class="empty"><p>لم تُسجل عهد بعد.</p></div><% } %></div></div></div>

<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-briefcase"/></svg> سجل العهد</h3><span class="chip spacer"><%= rows.length %></span></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الموظف</th><th>العهدة</th><th>المصروف</th><th>المرتجع</th><th>المتبقي</th><th>التاريخ</th><th></th></tr></thead><tbody><% rows.forEach(c=>{ %><tr><td><a href="<%= adminPath %>/users/<%= c.user_id %>#custody"><%= c.display_name %></a></td><td><b class="num"><%= money(c.amount) %></b><br><small><%= c.purpose %><%= c.reference?' · '+c.reference:'' %></small></td><td class="num"><%= money(c.spent) %></td><td class="num"><%= money(c.returned) %></td><td><b class="num"><%= money(c.remaining) %></b></td><td class="num"><%= c.issued_on %></td><td><% if(c.remaining>0){ %><details><summary class="btn ghost sm">تسجيل مرتجع</summary><form method="post" action="<%= adminPath %>/expenses/custodies/<%= c.id %>/return" class="mini-form"><%- csrfField %><input type="number" name="amount" max="<%= c.remaining %>" min="0.01" step="0.01" required placeholder="المبلغ"><input type="date" name="returned_on" value="<%= new Date().toISOString().slice(0,10) %>" required><input type="text" name="note" placeholder="ملاحظة"><button class="btn sm">حفظ</button></form></details><% } %><% if(c.spent===0&&c.returned===0){ %><details><summary class="btn danger ghost sm">إلغاء</summary><form method="post" action="<%= adminPath %>/expenses/custodies/<%= c.id %>/void" class="mini-form"><%- csrfField %><input type="text" name="reason" required placeholder="سبب الإلغاء"><button class="btn danger sm">تأكيد</button></form></details><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-check-circle"/></svg> الاعتماد والصرف</h3></div><div class="panel-body"><%rows.filter(c=>['pending_approval','approved','pending_receipt'].includes(c.status)).forEach(c=>{%><div class="mini-form"><b><%=c.display_name%> — <%=money(c.amount)%></b><span class="chip"><%=({pending_approval:'بانتظار الاعتماد',approved:'معتمدة بانتظار الصرف',pending_receipt:'بانتظار تأكيد الموظف'})[c.status]%></span><%if(c.status==='pending_approval'&&can('custody.approve')){%><form method="post" action="<%=adminPath%>/expenses/custodies/<%=c.id%>/approve"><%-csrfField%><button class="btn sm">اعتماد</button></form><%}%><%if(c.status==='approved'&&can('custody.disburse')){%><form method="post" action="<%=adminPath%>/expenses/custodies/<%=c.id%>/disburse"><%-csrfField%><button class="btn brass sm">صرف من الخزنة</button></form><%}%></div><%})%></div></div>
<%- include('../partials/admin_foot') %>
