<% pageTitle = 'لوحة التحكم' %>
<%- include('../partials/admin_head') %>
<%- include('../partials/admin_nav') %>

<div class="page-head">
  <h1>لوحة التحكم</h1>
  <p class="sub">أهلاً <%= user.display_name || user.username %>.</p>
</div>

<details class="panel" style="margin-bottom:16px">
  <summary class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-settings"/></svg> فلترة الفترة والفرع والمسؤول</h3><span class="spacer"></span><span class="btn ghost sm">تعديل</span></summary>
  <form class="dashboard-filters panel-body" method="get">
    <label>الفترة<select name="period"><%[['today','اليوم'],['week','هذا الأسبوع'],['month','هذا الشهر'],['custom','فترة مخصصة']].forEach(x=>{%><option value="<%=x[0]%>" <%=period===x[0]?'selected':''%>><%=x[1]%></option><%})%></select></label>
    <label>من<input type="date" name="from" value="<%=from%>"></label><label>إلى<input type="date" name="to" value="<%=to%>"></label>
    <label>الفرع<select name="branch_id" data-searchable data-placeholder="كل الفروع"><option value="">كل الفروع</option><%branches.forEach(b=>{%><option value="<%=b.id%>" <%=branchId===b.id?'selected':''%>><%=b.company_name%> — <%=b.name%></option><%})%></select></label>
    <label>المسؤول<select name="staff_id"><option value="">كل المسؤولين</option><%staffFilter.forEach(u=>{%><option value="<%=u.id%>" <%=staffId===u.id?'selected':''%>><%=u.display_name%></option><%})%></select></label><button class="btn brass">تحديث البيانات</button>
  </form>
</details>

<%
  /* Quick actions: real routes only, each gated by a permission key already
     verified elsewhere in this codebase — not a new access rule. */
  const quickActions = [];
  if (can('requests.create')) quickActions.push({href: adminPath+'/requests/new', label: 'طلب جديد', icon: 'i-plus'});
  if (can('treasury.view')) quickActions.push({href: adminPath+'/treasury', label: 'الخزنة', icon: 'i-wallet'});
  if (can('agenda.view')) quickActions.push({href: adminPath+'/agenda', label: 'الأجندة', icon: 'i-calendar'});
  if (can('users.manage')) quickActions.push({href: adminPath+'/users', label: 'الموظفون', icon: 'i-users'});
%>
<% if (quickActions.length) { %>
<div class="btn-row" style="margin-bottom:16px">
  <% quickActions.forEach(function(a) { %>
    <a class="btn ghost" href="<%=a.href%>"><svg aria-hidden="true" style="width:15px;height:15px"><use href="/images/icons.svg#<%=a.icon%>"/></svg> <%=a.label%></a>
  <% }) %>
</div>
<% } %>

<!-- =========================== primary KPI hierarchy =========================== -->
<div class="ws-section ws-stagger">
  <div class="kpi-hero-row">
    <% if (showMoney) { %>
      <a class="kpi-primary" href="<%=adminPath%>/treasury">
        <span class="kpi-label">رصيد الخزنة الحالي</span>
        <span class="kpi-value"><span data-count-to="<%=financial.treasury%>">0</span> <small><%=site.currency%></small></span>
        <span class="kpi-sub">إجمالي الأرصدة المتاحة عبر كل طرق الاستلام</span>
      </a>
    <% } else { %>
      <a class="kpi-primary" href="<%=adminPath%>/requests">
        <span class="kpi-label"><%= user.role === 'lawyer' ? 'طلباتي' : 'كل الطلبات' %></span>
        <span class="kpi-value"><span data-count-to="<%=total%>">0</span></span>
        <span class="kpi-sub">كل الطلبات المفتوحة والمنتهية الظاهرة لك</span>
      </a>
    <% } %>
    <div class="kpi-secondary-col">
      <% if (showMoney) { %>
        <a class="kpi-tile" href="<%=adminPath%>/requests"><span class="kpi-ico ic-brass stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></span><span><span class="kpi-label"><%= user.role === 'lawyer' ? 'طلباتي' : 'كل الطلبات' %></span><span class="kpi-value"><span data-count-to="<%=total%>">0</span></span></span></a>
        <a class="kpi-tile" href="<%=adminPath%>/revenue"><span class="kpi-ico <%= remaining > 0 ? 'ic-danger' : 'ic-ok' %> stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-receipt"/></svg></span><span><span class="kpi-label">المتبقي على العملاء</span><span class="kpi-value" style="color:<%= remaining > 0 ? 'var(--danger)' : 'var(--ok)' %>"><span data-count-to="<%=remaining%>">0</span></span></span></a>
      <% } else { %>
        <a class="kpi-tile" href="<%=adminPath%>/notifications"><span class="kpi-ico <%= notifications.length ? 'ic-danger' : 'ic-ok' %> stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-bell"/></svg></span><span><span class="kpi-label">إشعارات جديدة</span><span class="kpi-value"><span data-count-to="<%=notifications.length%>">0</span></span></span></a>
        <a class="kpi-tile" href="#due"><span class="kpi-ico ic-warn stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-clock"/></svg></span><span><span class="kpi-label">مواعيد متأخرة</span><span class="kpi-value"><%=attention.overdue%></span></span></a>
      <% } %>
    </div>
  </div>

  <% if (showMoney) { %>
  <div class="attention-list" style="margin-bottom:14px">
    <a class="attention-row" href="<%=adminPath%>/revenue"><span class="a-ico ic-ok stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-chevron-down"/></svg></span><span class="a-text"><span class="a-label">إجمالي الإيرادات</span><span class="a-value"><span data-count-to="<%=financial.revenue%>">0</span></span></span></a>
    <a class="attention-row" href="<%=adminPath%>/expenses"><span class="a-ico ic-danger stat-ico" aria-hidden="true"><svg style="transform:rotate(180deg)"><use href="/images/icons.svg#i-chevron-down"/></svg></span><span class="a-text"><span class="a-label">إجمالي المصروفات</span><span class="a-value"><span data-count-to="<%=financial.expenses%>">0</span></span></span></a>
    <a class="attention-row" href="<%=adminPath%>/expenses/custodies"><span class="a-ico ic-violet stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-briefcase"/></svg></span><span class="a-text"><span class="a-label">عهد الموظفين</span><span class="a-value"><span data-count-to="<%=financial.custody%>">0</span></span></span></a>
    <a class="attention-row" href="<%=adminPath%>/notifications"><span class="a-ico <%= notifications.length ? 'ic-danger' : 'ic-ok' %> stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-bell"/></svg></span><span class="a-text"><span class="a-label">إشعارات جديدة</span><span class="a-value"><span data-count-to="<%=notifications.length%>">0</span></span></span></a>
  </div>
  <% } %>
</div>

<!-- =========================== requests requiring attention =========================== -->
<div class="ws-section">
  <div class="ws-section-head"><h2><svg aria-hidden="true"><use href="/images/icons.svg#i-alert-triangle"/></svg> يحتاج انتباهك</h2></div>
  <div class="attention-list">
    <a class="attention-row <%=unseenCount?'urgent':'ok'%>" href="<%=adminPath%>/notifications"><span class="a-ico ic-danger stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-bell"/></svg></span><span class="a-text"><span class="a-label">الإشعارات الجديدة</span><span class="a-value"><%=unseenCount%></span></span></a>
    <a class="attention-row <%=attention.renewals?'warn':'ok'%>" href="<%=adminPath%>/renewals"><span class="a-ico ic-warn stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-refresh"/></svg></span><span class="a-text"><span class="a-label">الانتهاء والتجديد</span><span class="a-value"><%=attention.renewals%></span></span></a>
    <a class="attention-row <%=attention.overdue?'urgent':'ok'%>" href="#due"><span class="a-ico ic-danger stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-clock"/></svg></span><span class="a-text"><span class="a-label">المواعيد المتأخرة</span><span class="a-value"><%=attention.overdue%></span></span></a>
    <a class="attention-row <%=attention.todayTasks?'warn':'ok'%>" href="<%=adminPath%>/agenda"><span class="a-ico ic-info stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-check-circle"/></svg></span><span class="a-text"><span class="a-label">مهام اليوم</span><span class="a-value"><%=attention.todayTasks%></span></span></a>
  </div>
</div>

<!-- =========================== requests by status: real visualization ================= -->
<%
  const statusKeys = Object.keys(STATUS).filter(k => k !== 'completed');
  const statusMax = Math.max(1, ...statusKeys.map(k => byStatus[k] || 0));
%>
<div class="ws-section">
  <div class="panel">
    <div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-chart"/></svg> الطلبات حسب الحالة</h3><span class="chip spacer"><%=total%> إجمالي</span></div>
    <div class="panel-body">
      <div class="bar-compare">
        <% statusKeys.forEach(function(k) { var v = byStatus[k] || 0; %>
        <a class="bar-compare-row" href="<%=adminPath%>/requests?status=<%=k%>" style="text-decoration:none;color:inherit">
          <span class="bc-label"><span class="dot" style="background:<%=STATUS[k].color%>"></span><%=STATUS[k].ar%></span>
          <span class="bar-compare-track"><span class="bar-compare-fill" style="width:<%= Math.round(v/statusMax*100) %>%;background:<%=STATUS[k].color%>"></span></span>
          <span class="bc-count"><%=v%></span>
        </a>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- =========================== workspace: notifications/requests + side context ======== -->
<div class="ws-layout with-side">
  <div>
    <!-- notifications -->
    <div class="panel">
      <div class="panel-head">
        <h3>إشعارات محتاجة انتباهك</h3>
        <a href="<%= adminPath %>/notifications" class="btn ghost sm spacer">الكل</a>
      </div>
      <div class="panel-body">
        <% if (notifications.length) { %>
          <% notifications.forEach(n => { %>
            <div class="notif unseen">
              <span class="ic"><svg aria-hidden="true"><use href="/images/icons.svg#<%= { comment:'i-message', assigned:'i-user', status:'i-refresh', deadline:'i-calendar', upload:'i-paperclip' }[n.type] || 'i-bell' %>"/></svg></span>
              <div class="nb <%= n.priority === 'critical' ? 'critical' : '' %>">
                <div class="m"><%= n.text %></div>
                <div class="meta"><%= n.ref || '' %> · <%= timeAgo(n.created_at) %></div>
              </div>
              <div class="acts">
                <a class="btn ghost sm" href="<%= adminPath %>/requests/<%= n.request_id %>">افتح</a>
                <a class="btn ghost sm" href="<%= adminPath %>/requests/<%= n.request_id %>"
                   target="_blank" rel="noopener" title="فتح في تاب جديدة">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                       stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <path d="M15 3h6v6M10 14L21 3"/>
                  </svg>
                </a>
                <form method="post" action="<%= adminPath %>/notifications/<%= n.id %>/seen">
                  <%- csrfField %>
                  <input type="hidden" name="next" value="<%= adminPath %>">
                  <button class="btn ghost sm" type="submit">شوفتها</button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty" style="padding:24px"><p>مفيش إشعارات جديدة. كل حاجة تحت السيطرة.</p></div>
        <% } %>
      </div>
    </div>

    <!-- latest requests -->
    <div class="panel">
      <div class="panel-head">
        <h3>آخر الطلبات</h3>
        <a href="<%= adminPath %>/requests" class="btn ghost sm spacer">الكل</a>
      </div>
      <div class="panel-body flush">
        <% if (recent.length) { %>
          <table class="tbl">
            <thead><tr><th>الرقم</th><th>العميل</th><th>الحالة</th><th>التاريخ</th></tr></thead>
            <tbody>
              <% recent.forEach(r => { %>
                <tr onclick="location.href='<%= adminPath %>/requests/<%= r.id %>'" style="cursor:pointer">
                  <td data-label="الرقم"><a class="ref num" href="<%= adminPath %>/requests/<%= r.id %>"><%= r.ref %></a></td>
                  <td data-label="العميل"><strong><%= r.name %></strong></td>
                  <td data-label="الحالة">
                    <span class="badge" style="background:<%= STATUS[r.status] ? STATUS[r.status].color : '#888' %>">
                      <%= STATUS[r.status] ? STATUS[r.status].ar : r.status %>
                    </span>
                  </td>
                  <td data-label="التاريخ" style="color:var(--muted)"><%= timeAgo(r.created_at) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty"><span class="big"><svg aria-hidden="true"><use href="/images/icons.svg#i-folder"/></svg></span><p>مفيش طلبات لسه.</p></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="ws-side">
    <!-- unclaimed -->
<% if (unclaimed && unclaimed.length) { %>
  <div class="panel" style="border-inline-start:4px solid var(--warn)">
    <div class="panel-head">
      <h3>محدش استلمها</h3>
      <span class="chip spacer" style="background:var(--warn-bg);color:#8a6416">
        <%= unclaimed.length %>
      </span>
    </div>
    <div class="panel-body flush">
      <p class="help" style="padding:12px 16px 4px;margin:0">
        طلبات مفتوحة ومفيش محامي معيّن عليها — العميل مستني.
      </p>
      <ul class="timeline" style="padding:0 16px 12px">
        <% unclaimed.forEach(r => { %>
          <li>
            <span style="flex:1">
              <a class="num" href="<%= adminPath %>/requests/<%= r.id %>"><%= r.ref %></a>
              — <%= r.name %>
              <% if (r.page_label) { %><br><small><%= r.page_label %></small><% } %>
            </span>
            <span class="chip" style="flex:none;<%= r.waiting_days >= 5
              ? 'background:var(--danger-bg);color:#8f2f2b'
              : 'background:var(--warn-bg);color:#8a6416' %>">
              مستني <%= r.waiting_days %> يوم
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>

<!-- deadlines -->
    <div class="panel">
      <div class="panel-head">
        <h3>المواعيد</h3>
        <% if (overdueList.length) { %>
          <span class="chip spacer" style="background:var(--danger);color:#fff">
            <%= overdueList.length %> متأخر
          </span>
        <% } %>
      </div>
      <div class="panel-body">

        <%# Overdue first and always: the window below narrows what is still
            ahead, never what has already slipped. %>
        <% if (overdueList.length) { %>
          <div class="due-group overdue">
            <div class="due-group-head">متأخر — بغضّ النظر عن الفترة</div>
            <ul class="timeline">
              <% overdueList.slice(0, 8).forEach(r => { %>
                <li>
                  <span class="who" style="background:var(--danger-bg)">!</span>
                  <div class="what">
                    <div class="m">
                      <a class="ref num" href="<%= adminPath %>/requests/<%= r.id %>"><%= r.ref %></a>
                      — <%= r.name %>
                    </div>
                    <div class="meta">
                      <span class="num"><%= r.deadline %></span>
                      <span class="flag late">
                        متأخر <%= Math.round((new Date(today) - new Date(r.deadline)) / 86400000) %> يوم
                      </span>
                    </div>
                  </div>
                </li>
              <% }) %>
            </ul>
            <% if (overdueList.length > 8) { %>
              <a class="due-more" href="<%= adminPath %>/requests?open=1">
                + <%= overdueList.length - 8 %> طلب متأخر كمان
              </a>
            <% } %>
          </div>
        <% } %>

        <div class="due-filters">
          <% [['week','أسبوع'],['month','شهر'],['quarter','٣ شهور'],['half','٦ شهور']].forEach(([key, label]) => { %>
            <a href="<%= adminPath %>/?due=<%= key %>#due"
               class="qf sm <%= horizon === key ? 'on' : '' %>"><%= label %></a>
          <% }) %>
        </div>

        <div id="due">
          <% if (upcomingList.length) { %>
            <ul class="timeline">
              <% upcomingList.forEach(r => { %>
                <li>
                  <span class="who" style="background:<%= r.deadline === today ? 'var(--warn-bg)' : 'var(--bg)' %>"><svg aria-hidden="true" style="width:14px;height:14px"><use href="/images/icons.svg#i-clock"/></svg></span>
                  <div class="what">
                    <div class="m">
                      <a class="ref num" href="<%= adminPath %>/requests/<%= r.id %>"><%= r.ref %></a>
                      — <%= r.name %>
                    </div>
                    <div class="meta">
                      <span class="num"><%= r.deadline %></span>
                      <% if (r.deadline === today) { %><span class="flag soon">النهاردة</span><% } %>
                    </div>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="empty" style="padding:20px">
              <p>مفيش مواعيد في الـ <%= horizonDays %> يوم الجايين.</p>
            </div>
          <% } %>
        </div>

        <% if (!overdueList.length && !upcomingList.length) { %>
          <div class="empty" style="padding:24px"><p>مفيش مواعيد متأخرة ولا قريبة.</p></div>
        <% } %>
      </div>
    </div>

    <% if (activity.length) { %>
      <div class="panel">
        <div class="panel-head">
          <h3>آخر النشاط</h3>
          <a href="<%= adminPath %>/activity" class="btn ghost sm spacer">السجل</a>
        </div>
        <div class="panel-body">
          <ul class="timeline">
            <% activity.forEach(a => { %>
              <li>
                <span class="who"><%= (a.user_label || '؟').charAt(0) %></span>
                <div class="what">
                  <div class="m"><%= a.details || a.action %></div>
                  <div class="meta"><%= a.user_label %> · <%= timeAgo(a.created_at) %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/admin_foot') %>
