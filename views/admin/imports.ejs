<% pageTitle='استيراد البيانات' %><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'استيراد البيانات'}]})%>
<div class="page-head page-head-row"><div><h1>استيراد بيانات <%=site.nameAr%></h1><p class="sub">هذه البيانات تُحفظ داخل حساب الجهة الحالية فقط. اختر فرع المكتب، ثم حمّل النموذج وارفعه للفحص قبل الحفظ.</p></div></div>
<%if(error){%><div class="alert danger"><b>تعذر متابعة الاستيراد</b><span><%=error%></span></div><%}%>

<%if(!batch){%>
<div class="import-steps"><div class="active"><b>1</b><span>تحميل النموذج</span></div><div><b>2</b><span>رفع ومعاينة</span></div><div><b>3</b><span>اعتماد وحفظ</span></div></div>
<% const defIcons = { requests:'i-list', cases:'i-scale', agenda:'i-calendar', clients:'i-user', companies:'i-building', branches:'i-map-pin', employees:'i-users' }; %>
<div class="import-grid">
<%Object.entries(definitions).forEach(([key,def])=>{%><section class="import-card"><header><i aria-hidden="true"><svg><use href="/images/icons.svg#<%=defIcons[key]||'i-folder'%>"/></svg></i><div><h3><%=def.label%></h3><p><%=def.note%></p></div></header><div class="import-actions"><a class="btn ghost" href="<%=adminPath%>/imports/template/<%=key%>">تحميل نموذج Excel</a><form method="post" action="<%=adminPath%>/imports/preview" enctype="multipart/form-data"><%-csrfField%><input type="hidden" name="entity" value="<%=key%>"><label>فرع المكتب أو الشركة<select name="office_branch_id" required><option value="">اختر الفرع</option><%officeBranches.forEach(b=>{%><option value="<%=b.id%>"><%=b.name%></option><%})%></select></label><label class="file-drop"><input type="file" name="file" accept=".xlsx,.xlsm" required><span>اختر الملف المعبأ</span><small>xlsx أو xlsm — حتى 5 MB</small></label><button class="btn brass block">رفع وفحص الملف</button></form></div></section><%})%>
</div>
<div class="panel import-rules"><div class="panel-head"><h3>طريقة العمل</h3></div><div class="panel-body"><ol><li>حمّل نموذجًا جديدًا عند كل عملية حتى تكون القوائم مطابقة لأحدث بيانات الموقع.</li><li>الخانات الذهبية اختيار من قائمة النظام، والبيضاء للبيانات المتغيرة، والرمادية يولدها النظام تلقائيًا.</li><li>اترك رقم الطلب ورقم ملف القضية فارغين؛ يمنحهما النظام نفس تسلسل ومراجع الطلبات المنشأة من الموقع.</li><li>يمكنك تعبئة حتى 2,000 صف، وستظهر الأخطاء قبل حفظ أي بيانات.</li><li>لا يغيّر النظام أي بيانات قبل الضغط على «اعتماد وحفظ».</li></ol></div></div>
<%}else{%>
<% const stepCheck = '<svg width="14" height="14" aria-hidden="true"><use href="/images/icons.svg#i-check"/></svg>'; %>
<div class="import-steps"><div class="done"><b><%-stepCheck%></b><span>تحميل النموذج</span></div><div class="<%=batch.status==='review'?'active':'done'%>"><b><%-batch.status==='review'?'2':stepCheck%></b><span>رفع ومعاينة</span></div><div class="<%=batch.status==='completed'?'done active':''%>"><b><%-batch.status==='completed'?stepCheck:'3'%></b><span>اعتماد وحفظ</span></div></div>
<div class="panel"><div class="panel-head import-summary"><div><h3><%=definitions[batch.entity].label%></h3><small><%=batch.file_name%> · فرع المكتب: <b><%=batch.office_branch_name||'غير محدد'%></b></small></div><div class="import-counts"><span><b><%=batch.total_rows%></b> صف</span><span class="ok"><b><%=batch.valid_rows%></b> صحيح</span><span class="bad"><b><%=batch.error_rows%></b> به أخطاء</span></div></div>
<div class="panel-body">
<%if(batch.status==='completed'){%><div class="import-success"><div class="success-mark" aria-hidden="true"><svg width="28" height="28"><use href="/images/icons.svg#i-check"/></svg></div><h2>تم حفظ البيانات بنجاح</h2><p>أضيف <b><%=batch.result.count%></b> سجل إلى النظام وسُجلت العملية في سجل النشاط.</p><%if(batch.result.refs&&batch.result.refs.length){%><p class="muted">المراجع المنشأة: <span dir="ltr"><%=batch.result.refs.join(' · ')%></span></p><%}%></div>
<%if(batch.result.credentials&&batch.result.credentials.length){%><div class="alert warn"><b>كلمات المرور المؤقتة — تظهر في هذه النتيجة فقط</b><span>انسخها الآن وسلم كل موظف بياناته بصورة آمنة. سيُطلب منه تغيير كلمة المرور عند أول دخول.</span></div><div class="table-wrap"><table class="tbl"><thead><tr><th>الموظف</th><th>اسم المستخدم</th><th>كلمة المرور المؤقتة</th></tr></thead><tbody><%batch.result.credentials.forEach(c=>{%><tr><td><%=c.name%></td><td dir="ltr"><code><%=c.username%></code></td><td dir="ltr"><code><%=c.password%></code></td></tr><%})%></tbody></table></div><%}%>
<div class="btn-row"><a class="btn brass" href="<%=adminPath%>/imports">عملية استيراد جديدة</a></div>
<%}else{%>
<%if(batch.error_rows){%><div class="alert danger"><b>الملف يحتاج تصحيحًا</b><span>صحح الصفوف الموضحة في Excel ثم ارفع الملف مرة أخرى. لم يتم حفظ أي بيانات.</span></div><%}else{%><div class="alert ok"><b>الملف سليم وجاهز</b><span>تم التحقق من الحقول والعلاقات والتكرار. راجع المعاينة ثم اعتمد الحفظ.</span></div><%}%>
<div class="table-wrap import-preview"><table class="tbl"><thead><tr><th>صف Excel</th><%definitions[batch.entity].fields.slice(0,6).forEach(f=>{%><th><%=f[1]%></th><%})%><th>نتيجة الفحص</th></tr></thead><tbody><%batch.rows.forEach((r,i)=>{const review=batch.reviews[i]||{rowNumber:i+2,errors:[]};%><tr class="<%=review.errors.length?'row-error':'row-ok'%>"><td class="num"><%=review.rowNumber%></td><%definitions[batch.entity].fields.slice(0,6).forEach(f=>{%><td><%=r[f[0]]||'—'%></td><%})%><td><%if(review.errors.length){%><ul class="cell-errors"><%review.errors.forEach(e=>{%><li><%=e%></li><%})%></ul><%}else{%><span class="check-ok"><svg width="14" height="14" aria-hidden="true"><use href="/images/icons.svg#i-check"/></svg> صحيح</span><%}%></td></tr><%})%></tbody></table></div>
<div class="import-footer"><a class="btn ghost" href="<%=adminPath%>/imports">إلغاء ورفع ملف آخر</a><%if(!batch.error_rows){%><form method="post" action="<%=adminPath%>/imports/commit/<%=batch.token%>"><%-csrfField%><button class="btn brass">اعتماد وحفظ <%=batch.valid_rows%> سجل</button></form><%}%></div>
<%}%>
</div></div>
<%}%>
<%-include('../partials/admin_foot')%>
