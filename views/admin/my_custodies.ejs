<%pageTitle='عهدتي'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><div class="page-head"><h1>عهدتي ومصروفاتي</h1><p class="sub">راجع العهدة، أكد استلامها، وتابع الرصيد والمصروفات والمرتجعات.</p></div><%if(msg){%><div class="alert ok">تم تأكيد الاستلام.</div><%}%><div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-ok">↓</i><div><span class="k">المستلم</span><b class="v"><%=statement.totals.received%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger">↑</i><div><span class="k">المصروف</span><b class="v"><%=statement.totals.spent%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info">↺</i><div><span class="k">المرتجع</span><b class="v"><%=statement.totals.returned%></b></div></div><div class="stat warn icon-stat"><i class="stat-ico ic-warn">⏱</i><div><span class="k">المتبقي</span><b class="v"><%=statement.totals.remaining%></b></div></div></div><div class="panel"><div class="panel-head"><h3>العهد</h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الغرض</th><th>المبلغ</th><th>الحالة</th><th>المتبقي</th><th></th></tr></thead><tbody><%statement.custodies.forEach(c=>{%><tr><td><%=c.purpose%></td><td><%=c.amount%></td><td><%=c.status%></td><td><%=c.remaining%></td><td><%if(c.status==='pending_receipt'){%><form method="post" action="<%=adminPath%>/expenses/my-custodies/<%=c.id%>/receive"><%-csrfField%><button class="btn brass sm">تأكيد الاستلام</button></form><%}%></td></tr><%})%></tbody></table></div></div><%-include('../partials/admin_foot')%>
