<%pageTitle='عهدتي'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><div class="page-head"><h1>عهدتي ومصروفاتي</h1><p class="sub">راجع العهدة، أكد استلامها، وتابع الرصيد والمصروفات والمرتجعات.</p></div><%if(msg){%><div class="alert ok">تم تأكيد الاستلام.</div><%}%><div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">المستلم</span><b class="v"><span data-count-to="<%=statement.totals.received%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger" aria-hidden="true"><svg style="transform:rotate(180deg)"><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">المصروف</span><b class="v"><span data-count-to="<%=statement.totals.spent%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-refresh"/></svg></i><div><span class="k">المرتجع</span><b class="v"><span data-count-to="<%=statement.totals.returned%>">0</span></b></div></div><div class="stat warn icon-stat"><i class="stat-ico ic-warn" aria-hidden="true"><svg><use href="/images/icons.svg#i-clock"/></svg></i><div><span class="k">المتبقي</span><b class="v"><span data-count-to="<%=statement.totals.remaining%>">0</span></b></div></div></div><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-briefcase"/></svg> العهد</h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الغرض</th><th>المبلغ</th><th>الحالة</th><th>المتبقي</th><th></th></tr></thead><tbody><%statement.custodies.forEach(c=>{%><tr><td><%=c.purpose%></td><td><%=c.amount%></td><td><%=c.status%></td><td><%=c.remaining%></td><td><%if(c.status==='pending_receipt'){%><form method="post" action="<%=adminPath%>/expenses/my-custodies/<%=c.id%>/receive"><%-csrfField%><button class="btn brass sm">تأكيد الاستلام</button></form><%}%></td></tr><%})%></tbody></table></div></div><%-include('../partials/admin_foot')%>
