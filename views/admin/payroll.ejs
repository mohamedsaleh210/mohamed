<%pageTitle='المرتبات والمكافآت'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'المرتبات والمكافآت'}]})%>
<div class="page-head"><h1>المرتبات والمكافآت والحوافز</h1><p class="sub">سند صرف مرتب شهري سري مرتبط ببيانات الموظفين وتقييم الأداء والخزنة، مع سند راتب مستقل لكل موظف.</p></div>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-check-circle"/></svg> رحلة سند صرف المرتب</h3></div><div class="panel-body"><div class="payroll-journey"><span><b>1</b> اختيار الشهر</span><span><b>2</b> إنشاء مسودة</span><span><b>3</b> إدخال يدوي أو Excel أو ترحيل</span><span><b>4</b> معاينة الفروقات والأخطاء</span><span><b>5</b> مراجعة المحاسب</span><span><b>6</b> اعتماد المخول</span><span><b>7</b> الصرف من الخزنة</span><span><b>8</b> سندات الرواتب والتقارير</span></div><p class="sub">لا يتم إنشاء أي حركة خزنة قبل الاعتماد، ولا يستطيع الموظف الاطلاع إلا على سند راتبه المصروف.</p></div></div>
<%if(msg){%><div class="alert ok"><span>تم حفظ العملية بنجاح.</span></div><%}%><%if(err){%><div class="alert danger"><span><%=err==='exists'?'يوجد سند صرف مرتب لهذه الفترة بالفعل.':err==='scope'?'اختر موظفًا واحدًا على الأقل عند تحديد نطاق مخصّص.':'تعذر تنفيذ العملية؛ راجع البيانات.'%></span></div><%}%>
<%if(all){%>
<div class="stat-grid"><div class="stat featured icon-stat"><i class="stat-ico ic-brass" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><span class="k">سندات صرف المرتبات</span><b class="v"><span data-count-to="<%=runs.length%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">إجمالي آخر سند صرف مرتب</span><b class="v"><span data-count-to="<%=Number(runs[0]?.net||0)%>">0</span> <%=site.currency%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-users"/></svg></i><div><span class="k">موظفون مسجلون</span><b class="v"><span data-count-to="<%=employees.length%>">0</span></b></div></div></div>
<%if(can('payroll.manage')){%><details class="panel" open><summary class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إنشاء سند صرف مرتب شهري جديد</h3></summary><form class="panel-body form-grid" method="post" action="<%=adminPath%>/payroll/runs" id="payrollRunForm"><%-csrfField%><label>شهر المرتب<input type="month" name="period" required></label><div class="field wide"><label>نطاق الموظفين</label><div class="scope-toggle"><label class="check"><input type="radio" name="employee_scope" value="all" checked><span class="txt">كل موظفي المكتب أو الشركة المسجلين (<%=employees.length%>)</span></label><label class="check"><input type="radio" name="employee_scope" value="specific"><span class="txt">اختيار موظفين معيّنين</span></label></div><div class="emp-picker" id="empPicker" hidden><%employees.forEach(e=>{%><label class="check"><input type="checkbox" name="employee_ids" value="<%=e.id%>"><span class="txt"><%=e.display_name%><%if(e.job_title){%> <small>— <%=e.job_title%></small><%}%></span></label><%})%></div></div><label>عنوان السند<input type="text" name="title" placeholder="سند صرف مرتب شهر..."></label><label class="wide">ملاحظات<textarea name="notes"></textarea></label><button class="btn brass">إنشاء المسودة واستدعاء الموظفين</button></form></details>
<script>document.getElementById('payrollRunForm').addEventListener('change',function(e){if(e.target.name!=='employee_scope')return;document.getElementById('empPicker').hidden=e.target.value!=='specific'});</script>
<%}%>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-list"/></svg> سندات صرف المرتبات</h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الفترة</th><th>الموظفون</th><th>صافي المرتبات</th><th>المصروف</th><th>الحالة</th><th></th></tr></thead><tbody><%runs.forEach(r=>{%><tr><td><b><%=r.title%></b><br><small><%=r.period%></small></td><td><%=r.employee_count%></td><td><%=Number(r.net).toLocaleString('en-US')%></td><td><%=r.paid_count%> / <%=r.employee_count%></td><td><span class="chip"><%=({draft:'مسودة',approved:'معتمد',partially_paid:'مصروف جزئيًا',paid:'تم الصرف'})[r.status]%></span></td><td><a class="btn ghost sm" href="<%=adminPath%>/payroll/runs/<%=r.id%>">فتح السند</a></td></tr><%})%></tbody></table></div></div>
<%if(can('payroll.manage')){%><details class="panel"><summary class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-settings"/></svg> تعريف رواتب الموظفين</h3><span class="chip spacer"><%=employees.length%></span></summary><div class="panel-body"><p class="sub">البيانات الشخصية والوظيفة تُستدعى من ملف الموظف. هنا تُحفظ البيانات المالية فقط.</p><%employees.forEach(u=>{%><details class="picker-box"><summary><b><%=u.legal_name||u.display_name%></b> — <%=u.job_title||'بدون مسمى وظيفي'%> <span class="spacer"><%=Number(u.basic_salary||0).toLocaleString('en-US')%></span></summary><form class="form-grid performance-editor" method="post" action="<%=adminPath%>/payroll/profiles/<%=u.id%>"><%-csrfField%><label>المرتب الأساسي<input type="number" min="0" step=".01" name="basic_salary" value="<%=u.basic_salary||0%>"></label><label>بدل السكن<input type="number" min="0" step=".01" name="housing_allowance" value="<%=u.housing_allowance||0%>"></label><label>بدل الانتقال<input type="number" min="0" step=".01" name="transport_allowance" value="<%=u.transport_allowance||0%>"></label><label>بدلات ثابتة أخرى<input type="number" min="0" step=".01" name="fixed_allowance" value="<%=u.fixed_allowance||0%>"></label><label>تأمينات افتراضية<input type="number" min="0" step=".01" name="insurance_default" value="<%=u.insurance_default||0%>"></label><label>ضريبة افتراضية<input type="number" min="0" step=".01" name="tax_default" value="<%=u.tax_default||0%>"></label><label>طريقة الصرف<select name="payment_method"><%Object.entries(METHODS).forEach(([k,v])=>{%><option value="<%=k%>" <%=u.payment_method===k?'selected':''%>><%=v%></option><%})%></select></label><label>البنك<input type="text" name="bank_name" value="<%=u.bank_name||''%>"></label><label class="wide">IBAN / رقم الحساب<input type="text" name="iban" value="<%=u.iban||''%>"></label><label class="wide">ملاحظات مالية<textarea name="notes"><%=u.notes||''%></textarea></label><button class="btn brass">حفظ تعريف الراتب</button></form></details><%})%></div></details><%}%>
<%}%>
<%if(own.length){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-receipt"/></svg> سندات راتبي</h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>الفترة</th><th>الإجمالي</th><th>الخصومات</th><th>الصافي</th><th></th></tr></thead><tbody><%own.forEach(i=>{%><tr><td><%=i.period%></td><td><%=Number(i.gross_amount).toLocaleString('en-US')%></td><td><%=Number(i.total_deductions).toLocaleString('en-US')%></td><td><b><%=Number(i.net_amount).toLocaleString('en-US')%></b></td><td><a class="btn ghost sm" target="_blank" href="<%=adminPath%>/payroll/items/<%=i.id%>/slip">سند الراتب</a></td></tr><%})%></tbody></table></div></div><%}%>
<%-include('../partials/admin_foot')%>
