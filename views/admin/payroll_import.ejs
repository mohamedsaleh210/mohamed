<%pageTitle='مراجعة استيراد سند صرف المرتب'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'المرتبات والمكافآت',href:adminPath+'/payroll'},{label:run.period,href:adminPath+'/payroll/runs/'+run.id},{label:'مراجعة Excel'}]})%>
<div class="page-head"><h1>مراجعة استيراد Excel</h1><p class="sub">لم يتم تعديل سند صرف المرتب حتى الآن. راجع الصفوف والفروقات ثم طبّق الملف.</p></div>
<%if(err){%><div class="alert danger"><span><%=err%></span></div><%}%>
<div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><span class="k">إجمالي الصفوف</span><b class="v"><span data-count-to="<%=batch.rows.length%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-check-circle"/></svg></i><div><span class="k">صحيحة</span><b class="v"><span data-count-to="<%=batch.valid_count%>">0</span></b></div></div><div class="stat warn icon-stat"><i class="stat-ico ic-warn" aria-hidden="true"><svg><use href="/images/icons.svg#i-alert-triangle"/></svg></i><div><span class="k">مرفوضة</span><b class="v"><span data-count-to="<%=batch.invalid_count%>">0</span></b></div></div></div>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-file"/></svg> <%=batch.file_name%></h3></div><div class="panel-body flush"><table class="tbl"><thead><tr><th>صف Excel</th><th>الموظف</th><th>النتيجة</th><th>الفروقات أو الأخطاء</th><th>الصافي الجديد</th></tr></thead><tbody><%batch.rows.forEach(r=>{%><tr><td><%=r.row%></td><td><b><%=r.employee_name||'غير معروف'%></b><br><small>كود <%=r.user_id||'—'%></small></td><td><span class="chip <%=r.errors.length?'danger':'ok'%>"><%=r.errors.length?'مرفوض':'صحيح'%></span></td><td><%if(r.errors.length){%><ul><%r.errors.forEach(x=>{%><li><%=x%></li><%})%></ul><%}else if(r.changes.length){%><ul><%r.changes.forEach(x=>{%><li><%=x%></li><%})%></ul><%}else{%>لا توجد تغييرات<%}%></td><td><b><%=Number(r.values.net_amount).toLocaleString('en-US')%></b></td></tr><%})%></tbody></table></div></div>
<div class="btn-row"><a class="btn ghost" href="<%=adminPath%>/payroll/runs/<%=run.id%>">رجوع دون تطبيق</a><%if(!batch.invalid_count){%><form method="post" action="<%=adminPath%>/payroll/imports/<%=batch.token%>/apply" onsubmit="return confirm('سيتم تحديث بيانات الموظفين داخل سند صرف المرتب. متابعة؟')"><%-csrfField%><button class="btn brass">اعتماد وتطبيق الملف</button></form><%}else{%><span class="sub">صحح الصفوف المرفوضة ثم ارفع الملف مرة أخرى.</span><%}%></div><%-include('../partials/admin_foot')%>
