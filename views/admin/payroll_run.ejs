<%pageTitle=run.title%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'المرتبات',href:adminPath+'/payroll'},{label:run.period}]})%>
<div class="page-head-row"><div class="page-head"><h1><%=run.title%></h1><p class="sub">الحالة: <b><%=({draft:'مسودة قابلة للتعديل',approved:'معتمد وجاهز للصرف',partially_paid:'مصروف جزئيًا',paid:'تم صرف السند'})[run.status]%></b> · أنشأه <%=run.created_by_label%><%if(run.approved_by_label){%> · اعتمده <%=run.approved_by_label%><%}%></p></div><%if(can('payroll.export')){%><a class="btn ghost" href="<%=adminPath%>/payroll/runs/<%=run.id%>/export.csv">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/payroll/runs/<%=run.id%>/print">PDF / طباعة</a><%}%></div>
<div class="panel"><div class="panel-body"><div class="payroll-journey compact"><span class="done"><b>1</b> الشهر والموظفون</span><span class="done"><b>2</b> المسودة</span><span class="<%=run.status==='draft'?'current':'done'%>"><b>3</b> الإدخال والمراجعة</span><span class="<%=run.status==='approved'||run.status==='partially_paid'||run.status==='paid'?'done':''%>"><b>4</b> الاعتماد</span><span class="<%=run.status==='partially_paid'?'current':run.status==='paid'?'done':''%>"><b>5</b> الصرف</span><span class="<%=run.status==='paid'?'current':''%>"><b>6</b> القسائم والتقارير</span></div></div></div>
<%if(msg){%><div class="alert ok"><span>تم تنفيذ العملية بنجاح.</span></div><%}%><%if(err){%><div class="alert danger"><span><%=({balance:'الرصيد المتاح بطريقة الصرف لا يكفي.',separation:'لا يجوز لمُعدّ السند اعتماده إلا بصلاحية الإدارة العليا.',locked:'السند معتمد ولا يقبل التعديل.',status:'حالة الراتب لا تسمح بالصرف.',method:'طريقة الصرف غير صحيحة.'})[err]||'تعذر تنفيذ العملية.'%></span></div><%}%>
<div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-violet" aria-hidden="true"><svg><use href="/images/icons.svg#i-users"/></svg></i><div><span class="k">الموظفون</span><b class="v"><span data-count-to="<%=run.employee_count%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><span class="k">إجمالي الاستحقاقات</span><b class="v"><span data-count-to="<%=Number(run.gross)%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger" aria-hidden="true"><svg style="transform:rotate(180deg)"><use href="/images/icons.svg#i-chevron-down"/></svg></i><div><span class="k">إجمالي الخصومات</span><b class="v danger-text"><span data-count-to="<%=Number(run.deductions)%>">0</span></b></div></div><div class="stat featured icon-stat"><i class="stat-ico ic-brass" aria-hidden="true"><svg><use href="/images/icons.svg#i-wallet"/></svg></i><div><span class="k">صافي المرتبات</span><b class="v"><span data-count-to="<%=Number(run.net)%>">0</span> <%=site.currency%></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-check-circle"/></svg></i><div><span class="k">تم الصرف</span><b class="v"><%=run.paid_count%> / <%=run.employee_count%></b></div></div></div>
<%if(run.status==='draft'&&can('payroll.manage')){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-info"/></svg> اختر طريقة إدخال بيانات الشهر</h3></div><div class="panel-body"><p class="sub">يمكنك الجمع بين الإدخال اليدوي وExcel قبل الاعتماد. الترحيل ينشئ مسودة مستقلة للشهر التالي.</p></div></div><div class="two-col wide"><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-upload"/></svg> Excel — تحميل ورفع القالب</h3></div><div class="panel-body"><p class="sub">حمّل القالب المعبأ بموظفي هذا الشهر، عدّل القيم المتغيرة، ثم ارفعه لمعاينة الفروقات والأخطاء قبل التطبيق.</p><a class="btn ghost" href="<%=adminPath%>/payroll/runs/<%=run.id%>/template.xlsx">تحميل قالب Excel</a><form method="post" enctype="multipart/form-data" action="<%=adminPath%>/payroll/runs/<%=run.id%>/import"><%-csrfField%><label>ملف Excel<input type="file" name="file" accept=".xlsx,.xlsm" required></label><button class="btn brass">رفع الملف والتحقق</button></form><%if(err==='excel'){%><div class="alert danger"><span><%=detail||'تعذر قراءة ملف Excel.'%></span></div><%}%></div></div><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-refresh"/></svg> الترحيل من الشهر السابق</h3></div><form class="panel-body" method="post" action="<%=adminPath%>/payroll/runs/<%=run.id%>/roll-forward"><%-csrfField%><p class="sub">ينقل الأساسي والبدلات الثابتة والتأمينات والضرائب فقط. لا ينقل الغياب أو التأخير أو الإضافي أو المكافآت والخصومات المؤقتة.</p><label>الشهر الجديد<input type="month" name="period" required></label><button class="btn">إنشاء سند الشهر التالي</button></form></div></div><%}%>
<%if(run.status==='draft'&&can('payroll.approve')){%><form method="post" action="<%=adminPath%>/payroll/runs/<%=run.id%>/approve" onsubmit="return confirm('اعتماد السند سيمنع تعديل بنوده. متابعة؟')"><%-csrfField%><button class="btn brass">اعتماد سند صرف المرتبات</button></form><%}%>
<div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-users"/></svg> تفاصيل الموظفين</h3></div><div class="panel-body"><%items.forEach(i=>{%><details class="picker-box payroll-item"><summary><span class="emp-avatar"><%=(i.employee_name||'?').trim().charAt(0)%></span><div class="emp-id"><b><%=i.employee_name%></b><%if(i.job_title){%><small><%=i.job_title%></small><%}%></div><span class="spacer"></span><span class="emp-net <%=Number(i.net_amount)>0?'has-amount':'zero-amount'%>"><%=Number(i.net_amount).toLocaleString('en-US')%> <%=site.currency%></span><span class="chip <%=i.status==='paid'?'ok':(i.status==='approved'?'brass':'off')%>"><%=i.status==='paid'?'تم الصرف':i.status==='approved'?'معتمد':'مسودة'%></span></summary>
<%if(run.status==='draft'&&can('payroll.manage')){%><form class="payroll-editor" method="post" action="<%=adminPath%>/payroll/items/<%=i.id%>"><%-csrfField%><h4>الاستحقاقات</h4><div class="form-grid"><label>المرتب الأساسي<input type="number" step=".01" min="0" name="basic_salary" value="<%=i.basic_salary%>"></label><label>بدل السكن<input type="number" step=".01" min="0" name="housing_allowance" value="<%=i.housing_allowance%>"></label><label>بدل الانتقال<input type="number" step=".01" min="0" name="transport_allowance" value="<%=i.transport_allowance%>"></label><label>بدلات ثابتة<input type="number" step=".01" min="0" name="fixed_allowance" value="<%=i.fixed_allowance%>"></label><label>مكافأة الأداء<input type="number" step=".01" min="0" name="performance_bonus" value="<%=i.performance_bonus%>"></label><label>حافز استثنائي<input type="number" step=".01" min="0" name="exceptional_incentive" value="<%=i.exceptional_incentive%>"></label><label>عمل إضافي<input type="number" step=".01" min="0" name="overtime_amount" value="<%=i.overtime_amount%>"></label><label>استحقاقات أخرى<input type="number" step=".01" min="0" name="other_earning" value="<%=i.other_earning%>"></label></div><label>بيان المكافآت والحوافز<textarea name="earning_note"><%=i.earning_note||''%></textarea></label><h4>الخصومات</h4><div class="form-grid"><label>غياب<input type="number" step=".01" min="0" name="absence_deduction" value="<%=i.absence_deduction%>"></label><label>تأخير<input type="number" step=".01" min="0" name="lateness_deduction" value="<%=i.lateness_deduction%>"></label><label>جزاءات<input type="number" step=".01" min="0" name="penalty_deduction" value="<%=i.penalty_deduction%>"></label><label>سلف<input type="number" step=".01" min="0" name="advance_deduction" value="<%=i.advance_deduction%>"></label><label>تأمينات<input type="number" step=".01" min="0" name="insurance_deduction" value="<%=i.insurance_deduction%>"></label><label>ضرائب<input type="number" step=".01" min="0" name="tax_deduction" value="<%=i.tax_deduction%>"></label><label>خصومات أخرى<input type="number" step=".01" min="0" name="other_deduction" value="<%=i.other_deduction%>"></label></div><label>بيان الخصومات<textarea name="deduction_note"><%=i.deduction_note||''%></textarea></label><div class="payroll-live"><span>إجمالي الاستحقاقات: <b data-gross><%=i.gross_amount%></b></span><span>الخصومات: <b data-deductions><%=i.total_deductions%></b></span><span>الصافي: <b data-net><%=i.net_amount%></b></span></div><button class="btn brass">حفظ تفاصيل الراتب</button></form><%}else{%><div class="payroll-summary"><p><b>الأساسي:</b> <%=i.basic_salary%> · <b>البدلات والحوافز:</b> <%=i.gross_amount-i.basic_salary%> · <b>الخصومات:</b> <%=i.total_deductions%> · <b>الصافي:</b> <%=i.net_amount%></p><p><%=i.earning_note||''%> <%=i.deduction_note||''%></p></div><%}%>
<div class="row"><a class="btn ghost sm" target="_blank" href="<%=adminPath%>/payroll/items/<%=i.id%>/slip">طباعة سند الراتب</a><%if(i.status==='approved'&&can('payroll.pay')){%><form class="row" method="post" action="<%=adminPath%>/payroll/items/<%=i.id%>/pay"><%-csrfField%><select name="treasury_id"><%treasuries.forEach(t=>{%><option value="<%=t.id%>"><%=t.name%></option><%})%></select><select name="method"><%Object.entries(METHODS).forEach(([k,v])=>{%><option value="<%=k%>"><%=v%></option><%})%></select><input type="text" name="reference" placeholder="مرجع الصرف"><button class="btn brass sm">صرف من الخزنة</button></form><%}%><%if(i.status==='paid'&&can('payroll.pay')){%><form method="post" action="<%=adminPath%>/payroll/items/<%=i.id%>/reverse" onsubmit="return confirm('سيتم إلغاء حركة الخزنة وإعادة الراتب إلى معتمد. متابعة؟')"><%-csrfField%><input type="hidden" name="reason" value="إلغاء سند صرف الراتب"><button class="btn ghost sm">إلغاء الصرف</button></form><%}%></div></details><%})%></div></div>
<script>document.addEventListener('input',function(e){var f=e.target.closest('.payroll-editor');if(!f)return;var earn=['basic_salary','housing_allowance','transport_allowance','fixed_allowance','performance_bonus','exceptional_incentive','overtime_amount','other_earning'],ded=['absence_deduction','lateness_deduction','penalty_deduction','advance_deduction','insurance_deduction','tax_deduction','other_deduction'],sum=a=>a.reduce((s,n)=>s+(Number(f.elements[n]?.value)||0),0),g=sum(earn),d=sum(ded);f.querySelector('[data-gross]').textContent=g.toLocaleString('en-US');f.querySelector('[data-deductions]').textContent=d.toLocaleString('en-US');f.querySelector('[data-net]').textContent=Math.max(0,g-d).toLocaleString('en-US')})</script>
<%-include('../partials/admin_foot')%>
