<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>سند راتب <%=item.employee_name%> — <%=item.period%></title><style>body{font-family:Tahoma,Arial;color:#0b2b34;margin:28px}header{display:flex;justify-content:space-between;border-bottom:3px solid #d1a747;padding-bottom:16px}.seal{border:2px solid #d1a747;border-radius:50%;padding:12px;font-weight:bold}.meta{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:20px 0}.box{border:1px solid #d8dcda;border-radius:8px;padding:12px}table{width:100%;border-collapse:collapse}th{background:#0b2b34;color:white}th,td{padding:9px;border:1px solid #d8dcda;text-align:right}.total{font-size:20px;background:#f6edda}.signs{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:55px;text-align:center}.actions{margin:15px 0}@media print{.actions{display:none}body{margin:10mm}}</style></head><body><header><div><h1>سند صرف راتب</h1><p>صادر من نظام سند · الفترة <%=item.period%></p></div><div class="seal">سند</div></header><div class="actions"><button onclick="window.print()">طباعة / حفظ PDF</button></div><div class="meta"><div class="box"><b>الموظف:</b> <%=item.employee_name%><br><b>المسمى:</b> <%=item.job_title||'—'%><br><b>الرقم القومي:</b> <%=item.national_id||'—'%></div><div class="box"><b>الحالة:</b> <%=item.status==='paid'?'تم الصرف':item.status==='approved'?'معتمد':'مسودة'%><br><b>تاريخ الصرف:</b> <%=item.paid_at||'—'%><br><b>الطريقة:</b> <%=METHODS[item.payment_method]||item.payment_method||'—'%><br><b>المرجع:</b> <%=item.payment_reference||'—'%></div></div><table><thead><tr><th>الاستحقاقات</th><th>المبلغ</th><th>الخصومات</th><th>المبلغ</th></tr></thead><tbody><%const e=[['المرتب الأساسي',item.basic_salary],['بدل السكن',item.housing_allowance],['بدل الانتقال',item.transport_allowance],['بدلات ثابتة',item.fixed_allowance],['مكافأة الأداء',item.performance_bonus],['حافز استثنائي',item.exceptional_incentive],['عمل إضافي',item.overtime_amount],['استحقاقات أخرى',item.other_earning]],d=[['غياب',item.absence_deduction],['تأخير',item.lateness_deduction],['جزاءات',item.penalty_deduction],['سلف',item.advance_deduction],['تأمينات',item.insurance_deduction],['ضرائب',item.tax_deduction],['خصومات أخرى',item.other_deduction]];for(let n=0;n<Math.max(e.length,d.length);n++){%><tr><td><%=e[n]?.[0]||''%></td><td><%=e[n]?Number(e[n][1]).toLocaleString('en-US'):''%></td><td><%=d[n]?.[0]||''%></td><td><%=d[n]?Number(d[n][1]).toLocaleString('en-US'):''%></td></tr><%}%><tr><th>إجمالي الاستحقاقات</th><th><%=Number(item.gross_amount).toLocaleString('en-US')%></th><th>إجمالي الخصومات</th><th><%=Number(item.total_deductions).toLocaleString('en-US')%></th></tr><tr class="total"><th colspan="3">صافي المرتب المستحق</th><th><%=Number(item.net_amount).toLocaleString('en-US')%></th></tr></tbody></table><%if(item.earning_note||item.deduction_note){%><div class="box" style="margin-top:16px"><b>البيان:</b> <%=item.earning_note||''%> <%=item.deduction_note||''%></div><%}%><div class="signs"><div>إعداد<br><br>................</div><div>اعتماد<br><br>................</div><div>استلام الموظف<br><br>................</div></div></body></html>
