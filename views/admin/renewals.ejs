<%pageTitle='الانتهاء والتجديد'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%><%-include('../partials/crumbs',{crumbs:[{label:'الانتهاء والتجديد'}]})%><div class="page-head-row"><div class="page-head"><h1>مواعيد الانتهاء والتجديد</h1><p class="sub">الخدمات والشهادات التي قاربت على الانتهاء أو انتهت.</p></div><a class="btn ghost" href="<%=adminPath%>/renewals/export.csv?state=<%=state%>">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/renewals/print?state=<%=state%>">PDF / طباعة</a></div><div class="toolbar"><%[['all','الكل'],['soon','خلال 30 يوم'],['expired','منتهية'],['active','سارية']].forEach(x=>{%><a class="btn <%=state===x[0]?'brass':'ghost'%>" href="?state=<%=x[0]%>"><%=x[1]%></a><%})%></div><div class="panel"><div class="panel-body flush"><table class="tbl"><thead><tr><th>الطلب</th><th>العميل</th><th>الخدمة</th><th>الإصدار</th><th>الانتهاء</th><th>موعد التجديد</th></tr></thead><tbody><%rows.forEach(r=>{%><tr onclick="location.href='<%=adminPath%>/requests/<%=r.id%>'"><td><b><%=r.ref%></b></td><td><%=r.name%></td><td><%=r.service_label||'—'%></td><td><%=r.issued_on||'—'%></td><td class="<%=r.expires_on&&r.expires_on<today?'danger-text':''%>"><%=r.expires_on||'—'%></td><td><%=r.renewal_on||'—'%></td></tr><%})%></tbody></table><%if(!rows.length){%><div class="empty"><p>لا توجد نتائج.</p></div><%}%></div></div><%-include('../partials/admin_foot')%>
