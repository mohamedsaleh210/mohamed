<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title><%=title%></title><style>:root{--ink:<%=reportProfile&&reportProfile.primary_color||'#0b2b34'%>;--accent:<%=reportProfile&&reportProfile.accent_color||'#d1a747'%>}body{font-family:Tahoma,Arial;color:var(--ink);margin:28px}header{border-bottom:3px solid var(--accent);padding-bottom:14px;margin-bottom:22px}.brand{display:flex;align-items:center;gap:14px}.brand img{width:70px;max-height:60px;object-fit:contain}h1{margin:0}p{color:#718187}table{width:100%;border-collapse:collapse;font-size:12px}th{background:var(--ink);color:#fff}th,td{border:1px solid #d8dcda;padding:8px;text-align:right}.actions{margin:15px 0}.actions button{padding:10px 18px;background:var(--accent);border:0;border-radius:7px;font-weight:bold}@media print{.actions{display:none}body{margin:10mm}}</style></head><body><header><div class="brand"><%if(reportProfile&&reportProfile.logo_file){%><img src="<%=adminPath%>/report-profiles/assets/<%=reportProfile.logo_file%>" alt=""><%}%><div><%if(reportProfile){%><b><%=reportProfile.company_name_ar%></b><%}%><h1><%=title%></h1></div></div><p><%=reportProfile&&reportProfile.header_text||'تقرير صادر من نظام سند'%> · <%=generatedAt.toLocaleString('ar-EG')%></p></header><div class="actions"><button onclick="window.print()">حفظ أو طباعة PDF</button></div><table><thead><tr><%columns.forEach(c=>{%><th><%=c%></th><%})%></tr></thead><tbody><%rows.forEach(row=>{%><tr><%row.forEach(v=>{%><td><%=v==null?'—':v%></td><%})%></tr><%})%></tbody></table><%if(reportProfile&&reportProfile.footer_text){%><footer><%=reportProfile.footer_text%></footer><%}%></body></html>
