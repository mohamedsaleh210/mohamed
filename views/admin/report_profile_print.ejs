<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title><%=title%></title><style>:root{--ink:<%=reportProfile&&reportProfile.primary_color||'#0b2b34'%>;--accent:<%=reportProfile&&reportProfile.accent_color||'#d1a747'%>}body{font-family:Tahoma,Arial;color:var(--ink);margin:28px}header{border-bottom:3px solid var(--accent);padding-bottom:14px;margin-bottom:22px}.brand{display:flex;align-items:center;gap:14px}.brand img{width:70px;max-height:60px;object-fit:contain}h1{margin:0}h2{font-size:15px;margin:0 0 10px;color:var(--ink);border-inline-start:4px solid var(--accent);padding-inline-start:10px}p{color:#718187}.actions{margin:15px 0}.actions button{padding:10px 18px;background:var(--accent);border:0;border-radius:7px;font-weight:bold}section{margin-bottom:22px;break-inside:avoid}.fields{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid #d8dcda;border-radius:8px;overflow:hidden}.fields.single{grid-template-columns:1fr}.field{display:flex;border-bottom:1px solid #eceeed}.field:nth-last-child(-n+2){border-bottom:0}.field .label{flex:0 0 40%;padding:9px 12px;background:#f7f8f7;color:#718187;font-size:12px;border-inline-start:1px solid #eceeed}.field .value{flex:1;padding:9px 12px;font-size:13px;word-break:break-word}table{width:100%;border-collapse:collapse;font-size:12px;margin-top:4px}th{background:var(--ink);color:#fff}th,td{border:1px solid #d8dcda;padding:8px;text-align:right}@media print{.actions{display:none}body{margin:10mm}section{page-break-inside:avoid}}</style></head><body><header><div class="brand"><%if(reportProfile&&reportProfile.logo_file){%><img src="<%=adminPath%>/report-profiles/assets/<%=reportProfile.logo_file%>" alt=""><%}%><div><%if(reportProfile){%><b><%=reportProfile.company_name_ar%></b><%}%><h1><%=title%></h1><%if(subtitle){%><p style="margin:2px 0 0"><%=subtitle%></p><%}%></div></div><p><%=reportProfile&&reportProfile.header_text||'مستند صادر من نظام سند'%> · <%=generatedAt.toLocaleString('ar-EG')%></p></header><div class="actions"><button onclick="window.print()">حفظ أو طباعة PDF</button></div><%sections.forEach(function(sec){%><section><h2><%=sec.heading%></h2><%if(sec.table){%><table><thead><tr><%sec.table.columns.forEach(function(c){%><th><%=c%></th><%})%></tr></thead><tbody><%sec.table.rows.forEach(function(row){%><tr><%row.forEach(function(v){%><td><%=v==null||v===''?'—':v%></td><%})%></tr><%})%><%if(!sec.table.rows.length){%><tr><td colspan="<%=sec.table.columns.length%>" style="text-align:center;color:#718187">لا توجد سجلات</td></tr><%}%></tbody></table><%}else{%><div class="fields <%=sec.fields.length%2?'single':''%>"><%sec.fields.forEach(function(f){%><div class="field"><span class="label"><%=f[0]%></span><span class="value"><%=f[1]==null||f[1]===''?'—':f[1]%></span></div><%})%></div><%}%></section><%})%><%if(reportProfile&&reportProfile.footer_text){%><footer><%=reportProfile.footer_text%></footer><%}%></body></html>
