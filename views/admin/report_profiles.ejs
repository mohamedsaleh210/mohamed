<% pageTitle='بيانات المنشأة والهوية المالية' %><%- include('../partials/admin_head') %><%- include('../partials/admin_nav') %>
<%- include('../partials/crumbs',{crumbs:[{label:'الإعدادات',href:adminPath+'/settings'},{label:'هويات التقارير'}]}) %>
<div class="page-head"><h1>هوية تقارير <%=site.nameAr%></h1><p class="sub">كل هوية تخص الجهة الحالية وفرعًا محددًا منها، وتظهر في تقارير وفواتير وسندات هذا الفرع فقط.</p></div>
<% if(msg==='created'){%><div class="alert ok"><span>تم حفظ هوية التقرير.</span></div><%}%>
<div class="two-col wide"><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-shield"/></svg> الهويات المعتمدة</h3><span class="chip spacer"><%=rows.length%></span></div><div class="panel-body">
<% if(rows.length){rows.forEach(r=>{%><div class="report-profile-card"><%if(r.logo_file){%><img src="<%=adminPath%>/report-profiles/assets/<%=r.logo_file%>" alt=""><%}%><div><b><%=r.name%></b><br><span><%=r.company_name_ar%></span><br><small>فرع المكتب: <%=r.office_branch_name||'الفرع الرئيسي'%> <%=r.registration_no?' · سجل: '+r.registration_no:''%></small></div><div class="spacer"><%if(r.is_default){%><span class="chip ok">افتراضية للفرع</span><%}else{%><form method="post" action="<%=adminPath%>/report-profiles/<%=r.id%>/default"><%-csrfField%><button class="btn ghost sm">تعيين افتراضية للفرع</button></form><%}%></div></div><%})}else{%><div class="empty"><p>لم تُضف هوية تقارير بعد.</p></div><%}%>
</div></div><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إضافة هوية</h3></div><form class="panel-body" method="post" enctype="multipart/form-data" action="<%=adminPath%>/report-profiles/new"><%-csrfField%>
<div class="form-section"><div class="form-section-head"><i aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><b>البيانات الأساسية</b></div>
<div class="field req"><label>فرع المكتب أو الشركة</label><select name="office_branch_id" required><option value="">اختر الفرع</option><%branches.forEach(b=>{%><option value="<%=b.id%>"><%=b.name%></option><%})%></select></div><div class="field req"><label>اسم الهوية داخل النظام</label><input type="text" name="name" required placeholder="مثال: مكتب صالح للمحاماة"></div><div class="field req"><label>اسم الشركة بالعربية</label><input type="text" name="company_name_ar" required></div><div class="field"><label>Company name</label><input type="text" name="company_name_en" dir="ltr"></div>
<div class="two-col"><div class="field"><label>السجل التجاري</label><input type="text" name="registration_no"></div><div class="field"><label>الرقم الضريبي</label><input type="text" name="tax_no"></div></div><div class="field"><label>العنوان</label><input type="text" name="address"></div><div class="two-col"><div class="field"><label>الهاتف</label><input type="text" name="phone"></div><div class="field"><label>البريد</label><input name="email" type="email"></div></div><div class="field"><label>الموقع الإلكتروني</label><input type="text" name="website" dir="ltr"></div>
</div>
<div class="form-section"><div class="form-section-head"><i aria-hidden="true"><svg><use href="/images/icons.svg#i-scale"/></svg></i><b>التعريف القانوني والضريبي</b></div>
<div class="two-col"><div class="field"><label>نوع المنشأة</label><select name="entity_type"><option value="law_office">مكتب محاماة</option><option value="company">شركة</option><option value="legal_department">إدارة قانونية</option></select></div><div class="field"><label>الرقم الموحد</label><input type="text" name="unified_no"></div></div><div class="two-col"><label class="check"><input type="checkbox" name="vat_registered" value="1"><span class="txt">مسجلة في ضريبة القيمة المضافة</span></label><label class="check"><input type="checkbox" name="prices_include_tax" value="1"><span class="txt">الأسعار تشمل الضريبة</span></label></div><div class="two-col"><div class="field"><label>نسبة الضريبة الافتراضية %</label><input type="number" step="0.01" min="0" name="vat_rate" value="0"></div><div class="field"><label>العملة الأساسية</label><select name="currency"><option>EGP</option><option>SAR</option><option>USD</option><option>AED</option></select></div></div>
</div>
<div class="form-section"><div class="form-section-head"><i aria-hidden="true"><svg><use href="/images/icons.svg#i-receipt"/></svg></i><b>الفواتير والبنك</b></div>
<div class="two-col"><div class="field"><label>بداية السنة المالية</label><input type="text" name="fiscal_year_start" value="01-01" pattern="\d{2}-\d{2}"></div><div class="field"><label>بادئة رقم الفاتورة</label><input type="text" name="invoice_prefix" value="INV" dir="ltr"></div></div><div class="field"><label>اسم البنك</label><input type="text" name="bank_name"></div><div class="field"><label>IBAN</label><input type="text" name="iban" dir="ltr"></div>
</div>
<div class="form-section"><div class="form-section-head"><i aria-hidden="true"><svg><use href="/images/icons.svg#i-file"/></svg></i><b>الشعار والهوية البصرية للتقارير</b></div>
<div class="field"><label>الشعار</label><input type="file" name="logo" accept="image/png,image/jpeg,image/webp"><div class="help">PNG أو JPG أو WebP، بحد أقصى 2MB.</div></div><div class="field"><label>الترويسة</label><input type="text" name="header_text"></div><div class="field"><label>مقدمة التقرير</label><textarea name="intro_text"></textarea></div><div class="field"><label>الكليشة الختامية</label><textarea name="footer_text"></textarea></div>
<div class="two-col"><div class="field"><label>اسم الموقّع</label><input type="text" name="signatory_name"></div><div class="field"><label>صفته</label><input type="text" name="signatory_title"></div></div><div class="two-col"><div class="field"><label>صورة التوقيع</label><input type="file" name="signature" accept="image/png,image/jpeg,image/webp"></div><div class="field"><label>صورة الختم</label><input type="file" name="stamp" accept="image/png,image/jpeg,image/webp"></div></div><div class="field"><label>العلامة المائية</label><input type="text" name="watermark_text"></div><div class="two-col"><div class="field"><label>اللون الأساسي</label><input type="color" name="primary_color" value="#0b2b34"></div><div class="field"><label>لون التمييز</label><input type="color" name="accent_color" value="#d1a747"></div></div><label class="check"><input type="checkbox" name="is_default" value="1"><span class="txt">اجعلها الهوية الافتراضية</span></label>
</div>
<button class="btn brass block">حفظ الهوية</button>
</form></div></div><%- include('../partials/admin_foot') %>
