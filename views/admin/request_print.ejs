<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= reqRow.ref %> — ملف الطلب</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --ink:#12303a; --brass:#c9a24b; --muted:#66757e; --line:#dde3e1; }
    * { box-sizing: border-box; }
    body {
      font-family: 'Tajawal', system-ui, sans-serif;
      direction: rtl; margin: 0; color: #1e2a30; background: #eef1f0;
      font-size: 13px; line-height: 1.75;
    }
    .sheet {
      background: #fff; max-width: 820px; margin: 20px auto; padding: 36px 40px;
      box-shadow: 0 4px 24px rgba(0,0,0,.08);
    }

    .bar {
      position: sticky; top: 0; background: var(--ink); color: #fff;
      padding: 12px 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .bar b { font-size: 15px; }
    .bar .sp { margin-inline-start: auto; }
    .bar button, .bar a {
      background: var(--brass); color: var(--ink); border: 0; border-radius: 8px;
      padding: 9px 16px; font: inherit; font-weight: 800; cursor: pointer; text-decoration: none;
    }
    .bar a.ghost { background: rgba(255,255,255,.15); color: #fff; }

    header.doc { border-bottom: 3px solid var(--brass); padding-bottom: 16px; margin-bottom: 22px; }
    .seal {
      width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--brass);
      color: var(--brass); display: grid; place-items: center; font-weight: 800; font-size: 19px;
      float: left;
    }
    header.doc h1 { margin: 0; font-size: 24px; color: var(--ink); }
    header.doc .ref { direction: ltr; unicode-bidi: isolate; letter-spacing: .5px; }
    header.doc .meta { color: var(--muted); font-size: 12.5px; margin-top: 4px; }

    h2 {
      font-size: 15px; color: var(--ink); margin: 26px 0 10px; padding-bottom: 6px;
      border-bottom: 1.5px solid var(--line);
    }
    h2:first-of-type { margin-top: 0; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
    td, th { padding: 7px 10px; border-bottom: 1px solid #eef1f0; vertical-align: top; text-align: right; }
    th { font-size: 11.5px; color: var(--muted); font-weight: 800; background: #fafbfa; }
    td.k { color: var(--muted); width: 150px; }
    .num { direction: ltr; unicode-bidi: isolate; display: inline-block; }

    .badge { display: inline-block; padding: 2px 10px; border-radius: 20px; color: #fff; font-size: 11.5px; font-weight: 800; }
    .pill { display: inline-block; padding: 2px 9px; border-radius: 6px; background: #eef1f0; font-size: 11.5px; font-weight: 700; }

    .cmt { padding: 9px 0 9px 0; border-bottom: 1px solid #f2f5f4; page-break-inside: avoid; }
    .cmt .who { font-weight: 800; color: var(--ink); }
    .cmt .when { color: var(--muted); font-size: 11.5px; }
    .cmt .body { white-space: pre-wrap; margin-top: 3px; }
    .cmt.reply { margin-inline-start: 26px; border-inline-start: 2px solid var(--line); padding-inline-start: 12px; border-bottom: 0; }
    .cmt .body.struck { text-decoration: line-through; color: #9aa7ad; }
    .struck-note { font-size: 11px; color: #c15450; font-weight: bold; margin-top: 3px; }

    .thumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .thumbs figure { margin: 0; width: 150px; page-break-inside: avoid; }
    .thumbs img { width: 100%; border: 1px solid var(--line); border-radius: 6px; display: block; }
    .thumbs figcaption { font-size: 11px; color: var(--muted); margin-top: 3px; text-align: center; }
    .pdfbox {
      width: 150px; height: 200px; border: 1px solid var(--line); border-radius: 6px;
      display: grid; place-items: center; color: #c15450; font-weight: 800; background: #fdf7f6;
    }

    .totals { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 8px; font-size: 14px; }
    .totals b { font-size: 17px; display: block; }

    footer.doc { margin-top: 30px; padding-top: 12px; border-top: 1px solid var(--line);
      color: var(--muted); font-size: 11px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }

    @media (max-width:680px) {
      body { font-size: 14px; overflow-x: clip; }
      .bar { padding: 10px 12px; align-items: stretch; }
      .bar b, .bar .sp { width: 100%; }
      .bar a, .bar button { flex: 1 1 140px; min-height: 44px; text-align: center; }
      .sheet { width: 100%; max-width: 100%; margin: 0; padding: 22px 16px; box-shadow: none; }
      header.doc h1 { font-size: 20px; }
      table, tbody, tr, td { display: block; width: 100%; }
      thead { display: none; }
      tr { border: 1px solid var(--line); border-radius: 9px; margin-bottom: 10px; overflow: hidden; }
      td, td.k { width: 100%; padding: 8px 10px; overflow-wrap: anywhere; }
      td.k { background: #f7f9f8; font-weight: 800; }
      .thumbs figure, .pdfbox { width: min(100%, 180px); }
      .totals { gap: 12px; }
    }

    @media print {
      body { background: #fff; font-size: 11.5px; }
      .bar { display: none; }
      .sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; }
      h2 { page-break-after: avoid; }
      @page { margin: 14mm; }
    }
  </style>
</head>
<body>

<div class="bar">
  <b>ملف الطلب <span class="num"><%= reqRow.ref %></span></b>
  <span class="sp"></span>
  <a class="ghost" href="<%= adminPath %>/requests/<%= reqRow.id %>">رجوع</a>
  <button type="button" onclick="window.print()">حفظ كـ PDF / طباعة</button>
</div>

<div class="sheet">
  <%
    const st = STATUS[reqRow.status] || { ar: reqRow.status, color: '#888' };
    const relLabel = { self:'صاحب الطلب', guardian:'ولي أمر', agent:'وكيل', relative:'قريب', other:'أخرى' };
    const total = fees.reduce((n, f) => n + f.amount, 0);
    const remaining = total - (reqRow.paid_amount || 0);
    const roleAr = { admin:'أدمن', supervisor:'مشرف', lawyer:'محامي' };
    const doneTodos = todos.filter(t => t.done).length;
  %>

  <header class="doc">
    <%if(reportProfile&&reportProfile.logo_file){%><img src="<%=adminPath%>/report-profiles/assets/<%=reportProfile.logo_file%>" alt="" style="width:54px;max-height:54px;object-fit:contain;float:left"><%}else{%><div class="seal">س</div><%}%>
    <%if(reportProfile){%><strong><%=reportProfile.company_name_ar%></strong><%}%>
    <h1>طلب <span class="ref"><%= reqRow.ref %></span></h1>
    <div class="meta">
      <%= reqRow.service_label || 'بدون خدمة محددة' %> ·
      وصل <%= fmtDateTime(reqRow.created_at) %> ·
      <span class="badge" style="background:<%= st.color %>"><%= st.ar %></span>
    </div>
  </header>

  <h2>بيانات العميل</h2>
  <table>
    <tr><td class="k">الاسم</td><td><strong><%= reqRow.name %></strong>
      <span class="pill"><%= relLabel[reqRow.relation] || 'صاحب الطلب' %></span></td></tr>
    <% if (reqRow.beneficiary_name) { %>
      <tr><td class="k">صاحب الطلب</td><td><%= reqRow.beneficiary_name %></td></tr>
    <% } %>
    <tr><td class="k">الموبايل</td><td><span class="num"><%= reqRow.phone %></span></td></tr>
    <% if (reqRow.email) { %>
      <tr><td class="k">الإيميل</td><td><span class="num"><%= reqRow.email %></span></td></tr>
    <% } %>
    <tr><td class="k">حساب على الموقع</td><td><%= clientAccount ? 'نعم' : 'طلب بدون تسجيل' %></td></tr>
    <% if (reqRow.deadline) { %>
      <tr><td class="k">موعد التسليم</td><td><span class="num"><%= reqRow.deadline %></span></td></tr>
    <% } %>
    <tr><td class="k">المحامون</td><td>
      <%= assignees.length ? assignees.map(a => a.display_name).join('، ') : 'لم يُعيَّن أحد' %></td></tr>
  </table>

  <h2>تفاصيل الطلب</h2>
  <p style="white-space:pre-wrap;margin:0"><%= reqRow.message || '—' %></p>

  <% if (reqRow.special_request) { %>
    <h2>طلب خاص</h2>
    <p style="white-space:pre-wrap;margin:0"><%= reqRow.special_request %></p>
  <% } %>

  <% if (showMoney && fees.length) { %>
    <h2>الأتعاب</h2>
    <table>
      <thead><tr><th>البند</th><th>المبلغ</th><th>أضافه</th></tr></thead>
      <tbody>
        <% fees.forEach(f => { %>
          <tr>
            <td><%= f.label %></td>
            <td><span class="num"><%= f.amount.toLocaleString('en-US') %></span></td>
            <td style="color:var(--muted)"><%= f.created_by %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="totals">
      <div><span style="color:var(--muted)">الإجمالي</span><b class="num"><%= total.toLocaleString('en-US') %> <%= site.currency %></b></div>
      <div><span style="color:var(--muted)">المدفوع</span><b class="num" style="color:#3a9d6b"><%= (reqRow.paid_amount || 0).toLocaleString('en-US') %></b></div>
      <div><span style="color:var(--muted)">المتبقي</span><b class="num" style="color:<%= remaining > 0 ? '#c15450' : '#3a9d6b' %>"><%= remaining.toLocaleString('en-US') %></b></div>
    </div>
  <% } %>

  <% if (requirements.length) { %>
    <h2>المطلوب من العميل</h2>
    <table>
      <thead><tr><th>البند</th><th>الحالة</th><th>طلبه</th><th>استلمه</th></tr></thead>
      <tbody>
        <% requirements.forEach(rq => { %>
          <tr>
            <td><%= rq.title %></td>
            <td><%= rq.status === 'received' ? '✔ تم الاستلام' : '⏳ مطلوب' %></td>
            <td style="color:var(--muted)"><%= rq.created_by %></td>
            <td style="color:var(--muted)"><%= rq.received_by || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <% if (todos.length) { %>
    <h2>خطوات التنفيذ (<%= doneTodos %>/<%= todos.length %>)</h2>
    <table>
      <thead><tr><th>#</th><th>الخطوة</th><th>الحالة</th><th>خلّصها</th></tr></thead>
      <tbody>
        <% todos.forEach((t, i) => { %>
          <tr>
            <td style="width:30px;color:var(--muted)"><%= i + 1 %></td>
            <td <%= t.done ? 'style="color:#8b9aa1"' : '' %>><%= t.title %></td>
            <td><%= t.done ? '✔ تمت' : '○ لسه' %></td>
            <td style="color:var(--muted)"><%= t.done_by || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2>مستندات العميل (<%= documents.length %>)</h2>
  <% if (documents.length) { %>
    <% documents.forEach(d => { %>
      <div style="margin-bottom:14px;page-break-inside:avoid">
        <strong><%= d.name %></strong>
        <span class="pill"><%= d.kind === 'pdf' ? 'PDF' : d.files.length + ' صورة' %></span>
        <span style="color:var(--muted);font-size:11.5px">رفعه <%= d.uploaded_by %> · <%= fmtDate(d.created_at) %></span>
        <div class="thumbs">
          <% d.files.forEach(f => { %>
            <figure>
              <% if ((f.mime || '').startsWith('image/')) { %>
                <img src="/files/<%= f.id %>" alt="<%= d.name %>">
              <% } else { %>
                <div class="pdfbox">PDF</div>
              <% } %>
              <figcaption>
                <%= f.side === 'back' ? 'ظهر' : 'وجه' %>
                <% if (f.page_no > 1) { %> · صفحة <%= f.page_no %><% } %>
              </figcaption>
            </figure>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color:var(--muted);margin:0">لم يرفع العميل أي مستندات.</p>
  <% } %>

  <h2>التعليقات والتوثيق</h2>
  <% if (thread.length) { %>
    <% thread.forEach(c => { %>
      <div class="cmt">
        <span class="who"><%= c.author_label %></span>
        <span class="when">· <%= roleAr[c.author_role] || '' %> · <%= fmtDateTime(c.created_at) %></span>
        <div class="body <%= c.deleted_at ? 'struck' : '' %>"><%= c.body %></div>
        <% if (c.deleted_at) { %>
          <div class="struck-note">مشطوب بواسطة <%= c.deleted_by %></div>
        <% } %>

        <% c.replies.forEach(rep => { %>
          <div class="cmt reply">
            <span class="who"><%= rep.author_label %></span>
            <span class="when">· <%= roleAr[rep.author_role] || '' %> · <%= fmtDateTime(rep.created_at) %></span>
            <div class="body <%= rep.deleted_at ? 'struck' : '' %>"><%= rep.body %></div>
            <% if (rep.deleted_at) { %>
              <div class="struck-note">مشطوب بواسطة <%= rep.deleted_by %></div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color:var(--muted);margin:0">لا توجد تعليقات.</p>
  <% } %>

  <h2>سجل الطلب</h2>
  <% if (trail.length) { %>
    <table>
      <thead><tr><th>الوقت</th><th>مين</th><th>عمل إيه</th></tr></thead>
      <tbody>
        <% trail.slice().reverse().forEach(a => { %>
          <tr>
            <td style="color:var(--muted);white-space:nowrap"><%= fmtDateTime(a.created_at) %></td>
            <td><%= a.user_label %></td>
            <td><%= a.details || a.action %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color:var(--muted);margin:0">لا يوجد سجل.</p>
  <% } %>

  <footer class="doc">
    <span>طُبع بواسطة <%= printedBy %> · <%= fmtDateTime(new Date().toISOString()) %></span>
    <span><%=reportProfile&&reportProfile.footer_text||'مستند داخلي — لا يُسلَّم للعميل'%></span>
  </footer>
</div>

</body>
</html>
