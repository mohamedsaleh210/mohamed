<%pageTitle='الدعم الفني'%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%>
<div class="page-head-row"><div class="page-head"><h1>الدعم الفني</h1><p class="sub">متابعة التذاكر ومدة الاستجابة والحل من مكان واحد.</p></div><%if(can('support.reports')){%><a class="btn ghost" href="<%=adminPath%>/support/export.csv?<%=new URLSearchParams(filters).toString()%>">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/support/print?<%=new URLSearchParams(filters).toString()%>">PDF / طباعة</a><%}%></div>
<div class="stat-grid"><div class="stat icon-stat"><i class="stat-ico ic-brass" aria-hidden="true"><svg><use href="/images/icons.svg#i-list"/></svg></i><div><span class="k">إجمالي التذاكر</span><b class="v"><span data-count-to="<%=stats.total||0%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-info" aria-hidden="true"><svg><use href="/images/icons.svg#i-message"/></svg></i><div><span class="k">المفتوحة</span><b class="v"><span data-count-to="<%=stats.open_count||0%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-danger" aria-hidden="true"><svg><use href="/images/icons.svg#i-clock"/></svg></i><div><span class="k">المتأخرة</span><b class="v danger-text"><span data-count-to="<%=stats.overdue_count||0%>">0</span></b></div></div><div class="stat icon-stat"><i class="stat-ico ic-ok" aria-hidden="true"><svg><use href="/images/icons.svg#i-gauge"/></svg></i><div><span class="k">متوسط الحل</span><b class="v"><%=stats.avg_hours||0%> ساعة</b></div></div></div>
<form class="panel panel-body" method="get"><div class="form-grid"><label>بحث<input type="text" name="q" value="<%=filters.q||''%>" placeholder="رقم التذكرة أو العنوان أو العميل"></label><label>الأولوية<select name="priority"><option value="">كل الأولويات</option><%Object.entries(PRIORITIES).forEach(([k,v])=>{%><option value="<%=k%>" <%=filters.priority===k?'selected':''%>><%=v%></option><%})%></select></label></div><div class="multi-checks"><b>الحالات</b><%const selected=[].concat(filters.status||[]);Object.entries(STATUSES).forEach(([k,v])=>{%><label><input type="checkbox" name="status" value="<%=k%>" <%=selected.includes(k)?'checked':''%>> <%=v%></label><%})%></div><button class="btn brass">بحث</button></form>
<%if(can('support.create')){%><details class="panel"><summary class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> فتح تذكرة جديدة نيابةً عن العميل</h3></summary><form class="panel-body" method="post" enctype="multipart/form-data" action="<%=adminPath%>/support/new"><%-csrfField%><div class="form-grid"><label>اسم مقدم الطلب<input type="text" name="requester_name" required></label><label>رقم الموبايل<input type="text" name="requester_phone"></label><label>البريد<input type="email" name="requester_email"></label><label>نوع المشكلة<input type="text" name="issue_type" required placeholder="تقنية، حساب، اشتراك..."></label><label>الأولوية<select name="priority"><%Object.entries(PRIORITIES).forEach(([k,v])=>{%><option value="<%=k%>"><%=v%></option><%})%></select></label><label>موعد الحل المتوقع<input type="datetime-local" name="due_at"></label></div><label>العنوان<input type="text" name="title" required></label><label>شرح المشكلة<textarea name="description" required></textarea></label><label>مرفق صورة أو PDF<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,application/pdf"></label><button class="btn brass">فتح التذكرة</button></form></details><%}%>
<div class="support-grid"><%rows.forEach(t=>{%><a class="support-card priority-<%=t.priority%>" href="<%=adminPath%>/support/<%=t.id%>"><header><span class="ticket-ref"><%=t.ref%></span><span class="chip"><%=PRIORITIES[t.priority]%></span></header><h3><%=t.title%></h3><p><b><%=t.requester_name%></b><small><%=t.issue_type||'دعم فني'%></small></p><div class="support-meta"><span><small>الحالة</small><b><%=STATUSES[t.status]%></b></span><span><small>المسؤول</small><b><%=t.assignees||'غير معيّنة'%></b></span><span><small>موعد الحل</small><b><%=t.due_at?fmtDateTime(t.due_at):'غير محدد'%></b></span></div><footer>فتح ومتابعة التذكرة ←</footer></a><%})%><%if(!rows.length){%><div class="panel empty"><p>لا توجد تذاكر مطابقة.</p></div><%}%></div>
<%-include('../partials/admin_foot')%>
