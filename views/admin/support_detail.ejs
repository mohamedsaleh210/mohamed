<%pageTitle=t.ref%><%-include('../partials/admin_head')%><%-include('../partials/admin_nav')%>
<div class="page-head"><h1><%=t.ref%> — <%=t.title%></h1><p class="sub"><%=t.requester_name%> · <%=t.requester_phone||t.requester_email||''%></p></div>
<div class="two-col wide"><div><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-message"/></svg> سجل التذكرة</h3></div><div class="panel-body"><div class="ticket-thread"><%messages.forEach(m=>{%><article class="ticket-message <%=m.internal?'internal':''%>"><b><%=m.author_name%></b><small><%=fmtDateTime(m.created_at)%><%=m.internal?' · ملاحظة داخلية':''%></small><p><%=m.body%></p><%if(m.attachment_path){%><a href="/support-files/<%=m.attachment_path%>" target="_blank">عرض المرفق</a><%}%></article><%})%></div><%if(can('support.reply')){%><form method="post" enctype="multipart/form-data" action="<%=adminPath%>/support/<%=t.id%>/reply"><%-csrfField%><label>الرد<textarea name="body" required></textarea></label><label>مرفق<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,application/pdf"></label><%if(can('support.internal')){%><label><input type="checkbox" name="internal" value="1"> ملاحظة داخلية لا تظهر للعميل</label><%}%><button class="btn brass">إضافة الرد</button></form><%}%></div></div></div><div><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-settings"/></svg> إدارة التذكرة</h3></div><div class="panel-body"><p><b>الحالة:</b> <%=STATUSES[t.status]%><br><b>الأولوية:</b> <%=PRIORITIES[t.priority]%><br><b>الإنشاء:</b> <%=fmtDateTime(t.created_at)%><br><b>موعد الحل:</b> <%=t.due_at?fmtDateTime(t.due_at):'غير محدد'%></p><%if(can('support.manage')){%><form method="post" action="<%=adminPath%>/support/<%=t.id%>/manage"><%-csrfField%><label>الحالة<select name="status"><%Object.entries(STATUSES).forEach(([k,v])=>{%><option value="<%=k%>" <%=t.status===k?'selected':''%>><%=v%></option><%})%></select></label><label>الأولوية<select name="priority"><%Object.entries(PRIORITIES).forEach(([k,v])=>{%><option value="<%=k%>" <%=t.priority===k?'selected':''%>><%=v%></option><%})%></select></label><label>موعد الحل<input type="datetime-local" name="due_at" value="<%=t.due_at?String(t.due_at).slice(0,16):''%>"></label><button class="btn block">حفظ</button></form><%}%></div></div><%if(can('support.assign')){%><div class="panel"><div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-users"/></svg> المسؤولون</h3></div><form class="panel-body" method="post" action="<%=adminPath%>/support/<%=t.id%>/assign"><%-csrfField%><div class="multi-checks"><%const ids=assignees.map(x=>x.id);staff.forEach(u=>{%><label><input type="checkbox" name="user_ids" value="<%=u.id%>" <%=ids.includes(u.id)?'checked':''%>> <%=u.display_name%></label><%})%></div><button class="btn brass block">موافق وحفظ التعيين</button></form></div><%}%></div></div>
<%-include('../partials/admin_foot')%>
