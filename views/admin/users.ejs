<% pageTitle = 'الموظفين' %>
<%- include('../partials/admin_head') %>
<%- include('../partials/admin_nav') %>

<%- include('../partials/crumbs', { crumbs: [{ label: 'الموظفين' }] }) %>

<%
  const okMsgs = {
    added: 'تم إنشاء الحساب. سلّم الموظف كلمة السر المؤقتة — هيتطلب منه يغيّرها أول ما يدخل.',
    reset: 'تم تغيير كلمة السر. الموظف هيتطلب منه يغيّرها أول ما يدخل.',
    activated: 'تم تفعيل الحساب.',
    deactivated: 'تم إيقاف الحساب. تاريخه وملاحظاته كلها محفوظة.',
  };
  const errMsgs = {
    missing: 'الاسم واسم المستخدم مطلوبين.',
    email: 'الإيميل مطلوب وبصيغة صحيحة — من غيره الموظف مش هيقدر يستعيد كلمة سره.',
    mismatch: 'الكلمتان مش متطابقتين.',
    exists: 'اسم المستخدم ده موجود بالفعل.',
    username: 'اسم المستخدم يقبل حروف إنجليزي وأرقام و . _ - بس.',
    self: 'مش هتقدر توقف حسابك انت.',
    last_admin: 'ده آخر حساب أدمن شغّال — لو أوقفته محدش هيقدر يدير النظام.',
  };
  const roleLabel = { admin: 'أدمن', supervisor: 'مشرف', lawyer: 'محامي', accountant: 'محاسب' };
  const GROUP_ICON = {
    'الطلبات': 'i-list', 'إدارة مكتب المحاماة': 'i-scale', 'الفلوس': 'i-wallet',
    'المصاريف': 'i-receipt', 'تقييم الموظفين': 'i-gauge', 'المرتبات والمكافآت والحوافز': 'i-receipt',
    'العملاء': 'i-users', 'المشاوير': 'i-map-pin', 'أجندة الأعمال والتجديدات': 'i-calendar',
    'الدعم الفني': 'i-message', 'المحتوى': 'i-file', 'الحذف النهائي': 'i-trash', 'الإدارة': 'i-settings',
  };
  const initials = (u) => (u.display_name || u.username || '?').trim().charAt(0);

  /* One reset-password form definition, reused by both the desktop table row
     and the mobile card so the real /users/:id/reset contract (same field
     names, same CSRF field) is never duplicated by hand in two dialects. */
  function resetForm(u, domId) {
    return `<form method="post" action="${adminPath}/users/${u.id}/reset">
      ${csrfField}
      <div class="field" style="margin-bottom:8px"><label>كلمة سر مؤقتة</label>
        <input name="password" type="text" required data-pw="new" dir="ltr" style="text-align:left" autocomplete="off"></div>
      <div class="pw-meter" data-pw-meter data-level="0"><span class="pw-track"><i></i><i></i><i></i><i></i></span><span class="pw-label"></span></div>
      <ul class="pw-rules" data-pw-rules></ul>
      <div class="field" style="margin-bottom:6px"><label>اكتبها تاني</label>
        <input name="password_confirm" type="text" required data-pw="confirm" dir="ltr" style="text-align:left" autocomplete="off"></div>
      <p class="pw-match" data-pw-match></p>
      <div class="pw-tools"><button class="btn ghost sm" type="button" data-pw-suggest>اقترح كلمة سر قوية</button></div>
      <div class="btn-row"><button class="btn sm" type="submit">تعيين</button><button class="btn ghost sm" type="button" data-close-reset="${domId}">إلغاء</button></div>
      <p class="help" style="margin:8px 0 0">الموظف هيتطلب منه يغيّرها فوراً أول ما يدخل، وأي جلسة مفتوحة بحسابه هتتقفل.</p>
    </form>`;
  }
%>

<div class="page-head">
  <h1>الموظفين</h1>
  <p class="sub">حسابات الدخول للوحة الإدارة: أدمن، مشرف، محامي، ومحاسب.</p>
</div>

<!-- =========================== KPI hierarchy (compact context, not a wall of cards) === -->
<div class="ws-section ws-stagger">
  <div class="kpi-hero-row">
    <a class="kpi-primary" href="#roster">
      <span class="kpi-label">كل الموظفين</span>
      <span class="kpi-value"><span data-count-to="<%= users.length %>">0</span></span>
      <span class="kpi-sub"><%= users.filter(u => u.active).length %> شغّال الآن</span>
    </a>
    <div class="kpi-secondary-col">
      <div class="kpi-tile"><span class="kpi-ico ic-ok stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-check-circle"/></svg></span><span><span class="kpi-label">شغّالين</span><span class="kpi-value" style="color:var(--ok)"><span data-count-to="<%= users.filter(u => u.active).length %>">0</span></span></span></div>
      <% const stopped = users.filter(u => !u.active).length; const incomplete = users.filter(u => u.active && !u.profile_completed).length; %>
      <% if (stopped) { %><div class="kpi-tile"><span class="kpi-ico stat-ico" style="background:var(--line-soft);color:var(--muted)" aria-hidden="true"><svg><use href="/images/icons.svg#i-x-circle"/></svg></span><span><span class="kpi-label">موقوفين</span><span class="kpi-value" style="color:var(--muted)"><span data-count-to="<%= stopped %>">0</span></span></span></div>
      <% } else if (incomplete) { %><div class="kpi-tile"><span class="kpi-ico ic-warn stat-ico" aria-hidden="true"><svg><use href="/images/icons.svg#i-alert-triangle"/></svg></span><span><span class="kpi-label">بياناتهم ناقصة</span><span class="kpi-value" style="color:var(--warn)"><span data-count-to="<%= incomplete %>">0</span></span></span></div>
      <% } %>
    </div>
  </div>
</div>

<%if(can('users.export')){%><div class="btn-row" style="margin-bottom:14px"><a class="btn ghost" href="<%=adminPath%>/users/export.csv">Excel</a><a class="btn ghost" target="_blank" href="<%=adminPath%>/users/print">PDF / طباعة</a></div><%}%>

<% if (msg && okMsgs[msg]) { %><div class="alert ok"><span><%= okMsgs[msg] %></span></div><% } %>
<% if (err && errMsgs[err]) { %><div class="alert err"><span><%= errMsgs[err] %></span></div><% } %>
<% if (err === 'weak' && errText) { %><div class="alert err"><span><%= errText %></span></div><% } %>

<div class="panel" id="roster">
  <div class="panel-head">
    <h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-users"/></svg> الحسابات</h3>
    <span class="chip spacer"><%= users.filter(u => u.active).length %> شغّال</span>
  </div>
  <div class="panel-body">
    <%
      /* Real branch names only — no invented list. With today's single-
         office-branch demo data this select has one option, but the
         markup/JS is the same regardless of how many real office_branches
         exist, and is the natural slot a future searchable-branch combobox
         (V4 audit §5) would drop into without changing this filter's
         contract (a plain value match against data-branch). */
      const branchNames = [...new Set(users.map(u => u.branch_name).filter(Boolean))].sort();
    %>
    <div class="emp-toolbar prominent">
      <div class="emp-search"><svg aria-hidden="true"><use href="/images/icons.svg#i-search"/></svg><input type="search" id="empSearch" placeholder="بحث بالاسم أو اسم المستخدم أو المسمى الوظيفي…" aria-label="بحث في الموظفين"></div>
      <select id="empRoleFilter" aria-label="فلترة حسب الصلاحية"><option value="">كل الصلاحيات</option><% Object.entries(roleLabel).forEach(([k,v]) => { %><option value="<%=k%>"><%=v%></option><% }) %></select>
      <select id="empStatusFilter" aria-label="فلترة حسب الحالة"><option value="">كل الحالات</option><option value="active">شغّال</option><option value="off">موقوف</option></select>
      <% if (branchNames.length > 1) { %>
        <select id="empBranchFilter" aria-label="فلترة حسب الفرع" data-searchable data-placeholder="كل الفروع"><option value="">كل الفروع</option><% branchNames.forEach(b => { %><option value="<%=b%>"><%=b%></option><% }) %></select>
      <% } %>
    </div>
    <div class="emp-toolbar-status">
      <p class="emp-count-status" id="empCountStatus" role="status" aria-atomic="true"><%= users.length %> نتيجة</p>
      <div class="emp-pager" id="empPager" hidden>
        <button type="button" class="btn ghost sm" id="empPagerPrev" aria-label="الصفحة السابقة">‹ السابق</button>
        <span id="empPagerLabel" class="emp-pager-label"></span>
        <button type="button" class="btn ghost sm" id="empPagerNext" aria-label="الصفحة التالية">التالي ›</button>
      </div>
    </div>

    <div class="tbl-wrap emp-table-wrap">
      <table class="tbl" id="empTable">
        <thead>
          <tr><th>الاسم</th><th>اسم المستخدم</th><th>الصلاحية</th><th>الفرع</th><th>الحالة</th><th>أُنشئ</th><th></th></tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr style="<%= u.active ? '' : 'opacity:.6' %>" data-emp-row
                data-name="<%= (u.display_name||'') + ' ' + (u.username||'') + ' ' + (u.job_title||'') %>"
                data-role="<%= u.role %>" data-status="<%= u.active ? 'active' : 'off' %>" data-branch="<%= u.branch_name || '' %>">
              <td data-label="الاسم">
                <div class="identity-chip">
                  <span class="id-avatar" aria-hidden="true"><%= initials(u) %></span>
                  <span class="id-meta">
                    <span class="id-name"><%= u.display_name || u.username %><% if (u.id === user.id) { %> <span class="chip brass">أنت</span><% } %></span>
                    <span class="id-sub"><%= u.job_title || '—' %></span>
                    <% if (!u.profile_completed) { %><span class="chip warn" style="margin-top:2px">بياناته ناقصة</span><% } %>
                  </span>
                </div>
              </td>
              <td data-label="المستخدم"><span class="num"><%= u.username %></span></td>
              <td data-label="الصلاحية"><span class="chip teal"><%= roleLabel[u.role] || u.role %></span></td>
              <td data-label="الفرع"><%= u.branch_name || '—' %></td>
              <td data-label="الحالة">
                <% if (!u.active) { %>
                  <span class="chip off">موقوف</span>
                <% } else if (u.must_change_password) { %>
                  <span class="chip warn">لسه مغيّرش كلمة السر</span>
                <% } else { %>
                  <span class="chip ok">شغّال</span>
                <% } %>
              </td>
              <td data-label="أُنشئ" style="color:var(--muted);font-size:13px">
                <%= fmtDate(u.created_at) %>
                <% if (u.created_by) { %><br><span style="font-size:12px">بواسطة <%= u.created_by %></span><% } %>
              </td>
              <td data-label="إجراءات" class="row-actions">
                <a class="btn ghost sm" href="<%= adminPath %>/users/<%= u.id %>">الملف</a>
                <% if (u.role !== 'admin') { %>
                  <a class="btn ghost sm" href="<%= adminPath %>/users/<%= u.id %>/permissions">
                    الصلاحيات
                    <% if (u.exception_count) { %><span class="chip brass"><%= u.exception_count %></span><% } %>
                  </a>
                <% } %>
                <button class="btn ghost sm" type="button" data-reset="tr-<%= u.id %>" aria-expanded="false">كلمة سر جديدة</button>
                <% if (u.id !== user.id) { %>
                  <form method="post" action="<%= adminPath %>/users/<%= u.id %>/toggle" style="display:inline"
                        data-confirm="<%= u.active ? 'إيقاف حساب ' + (u.display_name || u.username) + '؟ مش هيقدر يدخل تاني بس تاريخه هيفضل محفوظ.' : 'تفعيل الحساب ده تاني؟' %>">
                    <%- csrfField %>
                    <button class="btn <%= u.active ? 'danger' : 'ghost' %> sm" type="submit">
                      <%= u.active ? 'إيقاف' : 'تفعيل' %>
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
            <tr id="reset-tr-<%= u.id %>" hidden><td colspan="7" style="background:#fbfcfb"><%- resetForm(u, 'tr-' + u.id) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="emp-grid" id="empGrid">
      <% users.forEach(u => { %>
        <div class="emp-card" data-emp-row
             data-name="<%= (u.display_name||'') + ' ' + (u.username||'') + ' ' + (u.job_title||'') %>"
             data-role="<%= u.role %>" data-status="<%= u.active ? 'active' : 'off' %>" data-branch="<%= u.branch_name || '' %>"
             style="<%= u.active ? '' : 'opacity:.65' %>">
          <div class="identity-chip">
            <span class="id-avatar lg" aria-hidden="true"><%= initials(u) %></span>
            <span class="id-meta">
              <span class="id-name"><%= u.display_name || u.username %></span>
              <span class="id-sub"><%= u.job_title || u.username %></span>
            </span>
          </div>
          <div class="emp-card-tags">
            <span class="chip teal"><%= roleLabel[u.role] || u.role %></span>
            <% if (!u.active) { %><span class="chip off">موقوف</span>
            <% } else if (u.must_change_password) { %><span class="chip warn">لسه مغيّرش كلمة السر</span>
            <% } else { %><span class="chip ok">شغّال</span><% } %>
            <% if (u.branch_name) { %><span class="chip"><%= u.branch_name %></span><% } %>
          </div>
          <div class="emp-card-actions">
            <a class="btn ghost sm" href="<%= adminPath %>/users/<%= u.id %>">الملف</a>
            <% if (u.role !== 'admin') { %><a class="btn ghost sm" href="<%= adminPath %>/users/<%= u.id %>/permissions">الصلاحيات<% if (u.exception_count) { %> <span class="chip brass"><%= u.exception_count %></span><% } %></a><% } %>
            <button class="btn ghost sm" type="button" data-reset="card-<%= u.id %>" aria-expanded="false">كلمة سر جديدة</button>
            <% if (u.id !== user.id) { %>
              <form method="post" action="<%= adminPath %>/users/<%= u.id %>/toggle"
                    data-confirm="<%= u.active ? 'إيقاف حساب ' + (u.display_name || u.username) + '؟ مش هيقدر يدخل تاني بس تاريخه هيفضل محفوظ.' : 'تفعيل الحساب ده تاني؟' %>">
                <%- csrfField %>
                <button class="btn <%= u.active ? 'danger' : 'ghost' %> sm" type="submit"><%= u.active ? 'إيقاف' : 'تفعيل' %></button>
              </form>
            <% } %>
          </div>
          <div id="reset-card-<%= u.id %>" hidden><%- resetForm(u, 'card-' + u.id) %></div>
        </div>
      <% }) %>
    </div>
    <p class="empty" id="empNoResults" hidden style="padding:24px"><span>مفيش موظف مطابق للبحث.</span></p>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h3><svg class="h3-ico" aria-hidden="true"><use href="/images/icons.svg#i-plus"/></svg> إضافة موظف</h3></div>
  <div class="panel-body">
    <form method="post" action="<%= adminPath %>/users/new">
      <%- csrfField %>

      <div class="alert info" style="margin-top:0">
        <span>
          محتاج اسم مستخدم وكلمة سر مؤقتة بس. الموظف هيغيّر كلمة السر أول ما يدخل،
          وهيكمّل بياناته بنفسه — الاسم والبريد والموبايل والرقم القومي<%= idRequired ? ' وصورة البطاقة' : '' %>.
          مش هيقدر يشتغل قبل ما يكمّلها.
          <br><br>
          <b>الصلاحيات بتيجي من الدور تلقائياً.</b>
          لو عايز تزوّد أو تشيل حاجة لشخص بعينه، هتلاقي زرار
          <b>«الصلاحيات»</b> جنب اسمه في القايمة بعد ما تضيفه.
        </span>
      </div>

      <div class="two-col">
        <div class="field req">
          <label>اسم المستخدم</label>
          <input type="text" name="username" required dir="ltr" style="text-align:left"
                 pattern="[a-z0-9._-]+" placeholder="khaled">
          <div class="help">حروف إنجليزي صغيرة وأرقام بس.</div>
        </div>
        <div class="field req">
          <label>الصلاحية</label>
          <select name="role" id="newRole" required>
            <option value="lawyer">محامي — طلباته هو فقط، بدون أرقام مالية</option>
            <option value="accountant">محاسب — الإيرادات والمصاريف، قراءة فقط</option>
            <option value="supervisor">مشرف — كل حاجة عدا الموظفين والإعدادات</option>
            <option value="admin">أدمن — بلا حدود</option>
          </select>
        </div>
      </div>

      <div class="field req">
        <label>كلمة سر مؤقتة</label>
        <input type="text" name="password" required data-pw="new" dir="ltr"
               style="text-align:left" autocomplete="off">
      </div>

      <div class="pw-meter" data-pw-meter data-level="0">
        <span class="pw-track"><i></i><i></i><i></i><i></i></span>
        <span class="pw-label"></span>
      </div>
      <ul class="pw-rules" data-pw-rules></ul>

      <div class="field req">
        <label>اكتبها تاني</label>
        <input type="text" name="password_confirm" required data-pw="confirm" dir="ltr"
               style="text-align:left" autocomplete="off">
      </div>
      <p class="pw-match" data-pw-match></p>

      <div class="pw-tools">
        <button class="btn ghost sm" type="button" data-pw-suggest>اقترح كلمة سر قوية</button>
      </div>
      <%
        /*
         * Permissions, on the same screen.
         *
         * They used to live behind a second visit after the account existed,
         * which meant every new person was briefly wrong and somebody had to
         * remember the follow-up. Here the defaults for the chosen role are
         * already ticked, and any adjustment is saved with the account.
         */
      %>
      <input type="hidden" name="_perms" value="1">

      <details class="perm-block" id="newPerms">
        <summary>
          <b>الصلاحيات</b>
          <span id="permSummary" class="chip"></span>
          <small>الافتراضي متعلّم حسب الدور — عدّل اللي تحبه</small>
        </summary>

        <div class="perm-body-wrap">
          <p class="help" id="permAdminNote" hidden>
            الأدمن صلاحياته مفتوحة ومش بتتحدد.
          </p>

          <div id="permGroups">
            <% Object.entries(catalogue).forEach(([groupKey, group]) => { %>
              <div class="perm-group <%= groupKey === 'erase' ? 'danger-group' : '' %>">
                <div class="perm-group-head">
                  <b><svg class="h3-ico" aria-hidden="true" style="opacity:.55"><use href="/images/icons.svg#<%= GROUP_ICON[group.label] || 'i-shield' %>"/></svg> <%= group.label %></b>
                  <% if (groupKey === 'erase') { %>
                    <span class="chip danger">
                      مفيش تراجع
                    </span>
                  <% } %>
                  <button type="button" class="perm-all" data-group="<%= groupKey %>">الكل</button>
                  <button type="button" class="perm-none" data-group="<%= groupKey %>">ولا حاجة</button>
                </div>
                <ul class="perm-list">
                  <% Object.entries(group.items).forEach(([key, item]) => { %>
                    <li>
                      <label class="perm-row">
                        <input type="checkbox" name="permission" value="<%= key %>"
                               data-group="<%= groupKey %>" data-perm="<%= key %>">
                        <span class="perm-body">
                          <b><%= item.label %></b>
                          <% if (item.note) { %><small><%= item.note %></small><% } %>
                        </span>
                        <span class="perm-tags">
                          <span class="chip default-tag" hidden>من الدور</span>
                        </span>
                      </label>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>
          </div>
        </div>
      </details>


      <button class="btn brass" type="submit">إنشاء الحساب</button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('click', function (e) {
    var open = e.target.closest('[data-reset]');
    if (open) {
      var row = document.getElementById('reset-' + open.getAttribute('data-reset'));
      if (row) {
        row.hidden = !row.hidden;
        open.setAttribute('aria-expanded', String(!row.hidden));
        if (!row.hidden) row.querySelector('input[name=password]').focus();
      }
    }
    var close = e.target.closest('[data-close-reset]');
    if (close) {
      var domId = close.getAttribute('data-close-reset');
      var r = document.getElementById('reset-' + domId);
      if (r) r.hidden = true;
      var trigger = document.querySelector('[data-reset="' + domId + '"]');
      if (trigger) { trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); }
    }
  });
</script>

<script>
(function () {
  'use strict';
  var search = document.getElementById('empSearch');
  var roleF = document.getElementById('empRoleFilter');
  var statusF = document.getElementById('empStatusFilter');
  var branchF = document.getElementById('empBranchFilter');
  var status = document.getElementById('empCountStatus');
  var noResults = document.getElementById('empNoResults');
  var pager = document.getElementById('empPager');
  var pagerLabel = document.getElementById('empPagerLabel');
  var pagerPrev = document.getElementById('empPagerPrev');
  var pagerNext = document.getElementById('empPagerNext');
  if (!search) return;

  /* Two parallel DOM representations (table rows, mobile cards) of the same
     employees, in the same order — filtered and paged identically so
     whichever one the current breakpoint shows always agrees with the
     other. Client-side only: the 38-and-growing roster the route already
     sends in full, no new request per page. */
  var tableRows = Array.prototype.slice.call(document.querySelectorAll('#empTable tbody > tr[data-emp-row]'));
  var cardRows = Array.prototype.slice.call(document.querySelectorAll('#empGrid > .emp-card[data-emp-row]'));
  if (!tableRows.length && !cardRows.length) return;

  var PAGE_SIZE = 12;
  var page = 1;

  function matches(row) {
    var q = (search.value || '').trim().toLowerCase();
    var role = roleF.value, st = statusF.value, br = branchF ? branchF.value : '';
    var okQ = !q || row.getAttribute('data-name').toLowerCase().indexOf(q) !== -1;
    var okRole = !role || row.getAttribute('data-role') === role;
    var okStatus = !st || row.getAttribute('data-status') === st;
    var okBranch = !br || row.getAttribute('data-branch') === br;
    return okQ && okRole && okStatus && okBranch;
  }

  function apply(resetPage) {
    if (resetPage) page = 1;
    var matchedTable = tableRows.filter(matches);
    var matchedCards = cardRows.filter(matches);
    var total = Math.max(matchedTable.length, matchedCards.length);
    var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (page > totalPages) page = totalPages;
    var start = (page - 1) * PAGE_SIZE, end = start + PAGE_SIZE;

    tableRows.forEach(function (r) { r.style.display = 'none'; });
    cardRows.forEach(function (r) { r.style.display = 'none'; });
    matchedTable.slice(start, end).forEach(function (r) { r.style.display = ''; });
    matchedCards.slice(start, end).forEach(function (r) { r.style.display = ''; });

    status.textContent = total + ' نتيجة' + (totalPages > 1 ? ' — صفحة ' + page + ' من ' + totalPages : '');
    noResults.hidden = total !== 0;

    if (pager) {
      pager.hidden = totalPages <= 1;
      pagerLabel.textContent = page + ' / ' + totalPages;
      pagerPrev.disabled = page <= 1;
      pagerNext.disabled = page >= totalPages;
    }
  }

  search.addEventListener('input', function () { apply(true); });
  roleF.addEventListener('change', function () { apply(true); });
  statusF.addEventListener('change', function () { apply(true); });
  if (branchF) branchF.addEventListener('change', function () { apply(true); });
  if (pagerPrev) pagerPrev.addEventListener('click', function () { if (page > 1) { page--; apply(false); window.scrollTo({ top: document.getElementById('roster').offsetTop - 12, behavior: 'auto' }); } });
  if (pagerNext) pagerNext.addEventListener('click', function () { page++; apply(false); window.scrollTo({ top: document.getElementById('roster').offsetTop - 12, behavior: 'auto' }); });

  apply(true);
})();
</script>

<script src="/js/password.js" defer></script>

<script>
(function () {
  'use strict';

  var roleSel = document.getElementById('newRole');
  var block   = document.getElementById('newPerms');
  if (!roleSel || !block) return;

  var groupsEl  = document.getElementById('permGroups');
  var adminNote = document.getElementById('permAdminNote');
  var summary   = document.getElementById('permSummary');

  // What each role grants out of the box, straight from the catalogue.
  var DEFAULTS = <%- JSON.stringify(roleDefaults) %>;
  var ALL = <%- JSON.stringify(allPermissions) %>;

  function boxes() {
    return Array.prototype.slice.call(groupsEl.querySelectorAll('input[name="permission"]'));
  }

  /*
   * Reset to the role's defaults.
   *
   * Called whenever the role changes, because a tick that made sense for a
   * lawyer is rarely the right starting point for an accountant — and carrying
   * it over silently would hand somebody access nobody chose to give them.
   */
  function applyRole() {
    var role = roleSel.value;
    var isAdmin = role === 'admin';
    var granted = DEFAULTS[role] || [];

    groupsEl.hidden = isAdmin;
    adminNote.hidden = !isAdmin;

    boxes().forEach(function (box) {
      var byRole = granted.indexOf(box.value) !== -1;
      box.checked = byRole;
      box.disabled = isAdmin;

      var tag = box.parentNode.querySelector('.default-tag');
      if (tag) tag.hidden = !byRole;
    });

    updateSummary();
  }

  function updateSummary() {
    if (roleSel.value === 'admin') {
      summary.textContent = 'بلا حدود';
      return;
    }
    var on = boxes().filter(function (b) { return b.checked; }).length;
    summary.textContent = on + ' من ' + ALL.length;
  }

  roleSel.addEventListener('change', applyRole);
  groupsEl.addEventListener('change', updateSummary);

  groupsEl.addEventListener('click', function (e) {
    var all = e.target.closest('.perm-all');
    var none = e.target.closest('.perm-none');
    var btn = all || none;
    if (!btn) return;

    var group = btn.getAttribute('data-group');
    boxes()
      .filter(function (b) { return b.getAttribute('data-group') === group; })
      .forEach(function (b) { b.checked = !!all; });

    updateSummary();
  });

  applyRole();
})();
</script>

