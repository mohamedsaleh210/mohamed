<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= lang === 'ar' ? 'حصل خطأ' : 'Something went wrong' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <section class="section">
    <div class="wrap" style="text-align:center;padding:70px 20px">
      <h1 style="color:var(--ink);margin:10px 0"><%= lang === 'ar' ? 'حصل خطأ عندنا' : 'Something went wrong' %></h1>
      <p style="color:var(--muted);margin-bottom:24px">
        <%= lang === 'ar' ? 'جرّب تحدّث الصفحة. لو الخطأ اتكرر كلّمنا.' : 'Try refreshing. If it keeps happening, get in touch.' %>
      </p>
      <a class="btn brass" href="/"><%= lang === 'ar' ? 'العودة للرئيسية' : 'Back to home' %></a>
    </div>
  </section>
</body>
</html>
