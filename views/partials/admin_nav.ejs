<%
const initials=(user.display_name||user.username||'؟').trim().charAt(0),on=(p,exact)=>((exact?path===p:path.startsWith(p))?'active':''),roleLabel=({admin:'أدمن',supervisor:'مشرف',lawyer:'محامي',accountant:'محاسب'})[user.role]||user.role,unseen=typeof unseenCount!=='undefined'?unseenCount:0,cm=typeof canModule==='function'?canModule:()=>true;
/* Phase 2 V3: was a Unicode-glyph map (▦▤▣...) rendered inside <i>; now
   returns the approved SVG icon system's markup directly (see
   public/images/icons.svg, ported from design/sanad-phase1-preview). Same
   function signature/call sites — only the visual glyph changed, no nav
   item, href, or permission gate touched. */
const NI_MAP={dashboard:'i-grid',requests:'i-list',cases:'i-scale',agenda:'i-check-circle',renewals:'i-refresh',support:'i-message',clients:'i-building',users:'i-users',performance:'i-gauge',payroll:'i-receipt',custody:'i-briefcase',treasury:'i-wallet',revenue:'i-chart',expenses:'i-receipt',consult:'i-calendar',social:'i-globe',content:'i-file',homepage:'i-home',subscriptions:'i-briefcase',security:'i-shield',activity:'i-clock',trash:'i-trash',settings:'i-settings',reports:'i-print',errands:'i-map-pin',imports:'i-upload',ai:'i-message'};
const ni=n=>`<svg class="nav-ico" aria-hidden="true"><use href="/images/icons.svg#${NI_MAP[n]||'i-grid'}"/></svg>`;
%>
<header class="topbar"><div class="topbar-inner"><a class="brand" href="<%=adminPath%>"><span class="seal"><span>س</span></span><b>سند</b></a><span class="topbar-spacer"></span><div class="topbar-mobile-actions"><button class="account-menu-toggle" id="menuBtn" type="button" aria-label="فتح قائمة الحساب" aria-expanded="false" aria-controls="sidebar"><svg aria-hidden="true"><use href="/images/icons.svg#i-menu"/></svg></button><a class="topbar-bell" href="<%=adminPath%>/notifications" aria-label="الإشعارات"><svg aria-hidden="true"><use href="/images/icons.svg#i-bell"/></svg><%if(unseen){%><span class="bell-dot"><%=unseen>99?'99+':unseen%></span><%}%></a></div><div class="topbar-user"><span class="who"><%=user.display_name||user.username%> · <%=roleLabel%></span><span class="avatar"><%if(user.photo){%><img src="<%=adminPath%>/account/avatar/<%=user.id%>" alt=""><%}else{%><%=initials%><%}%></span></div></div></header>
<div class="scrim" id="scrim"></div><aside class="sidebar" id="sidebar"><div class="sidebar-head"><span class="seal"><span>س</span></span><b>سند</b><button class="sidebar-close" id="sidebarClose" aria-label="إغلاق القائمة"><svg aria-hidden="true"><use href="/images/icons.svg#i-x"/></svg></button></div>
<nav class="side-nav side-nav-organized">
<a href="<%=adminPath%>" class="<%=on(adminPath,true)%>"><%-ni('dashboard')%>لوحة التحكم</a>
<%if(cm('agenda')&&cm('consultations')&&can('agenda.view')){%><a href="<%=adminPath%>/appointments" class="<%=on(adminPath+'/appointments')%>"><%-ni('consult')%>المواعيد والاستشارات</a><%}%>
<%if(cm('expenses')&&can('custody.view_own')){%><a href="<%=adminPath%>/expenses/my-custodies" class="<%=on(adminPath+'/expenses/my-custodies')%>"><%-ni('custody')%>عهدتي ومصروفاتي</a><%}%>
<%if(cm('ai')&&typeof aiAvailable!=='undefined'&&aiAvailable){%><a href="<%=adminPath%>/ai" class="<%=on(adminPath+'/ai')%>"><%-ni('ai')%>المساعد الذكي</a><%}%>
<details class="nav-group" open><summary>إدارة الأعمال</summary><%if(cm('requests')){%><a href="<%=adminPath%>/requests" class="<%=on(adminPath+'/requests')%>"><%-ni('requests')%>الطلبات</a><%}%><%if(cm('cases')){%><a href="<%=adminPath%>/cases" class="<%=on(adminPath+'/cases')%>"><%-ni('cases')%>القضايا</a><%}%><%if(cm('agenda')&&can('agenda.view')){%><a href="<%=adminPath%>/agenda" class="<%=on(adminPath+'/agenda')%>"><%-ni('agenda')%>أجندة الأعمال</a><%}%><%if(cm('renewals')&&can('renewals.view')){%><a href="<%=adminPath%>/renewals" class="<%=on(adminPath+'/renewals')%>"><%-ni('renewals')%>الانتهاء والتجديد<%if(renewalCount){%><span class="nav-badge"><%=renewalCount%></span><%}%></a><%}%><%if(cm('support')&&can('support.view')){%><a href="<%=adminPath%>/support" class="<%=on(adminPath+'/support')%>"><%-ni('support')%>الدعم الفني</a><%}%><%if(cm('errands')&&can('errands.view')){%><a href="<%=adminPath%>/errands" class="<%=on(adminPath+'/errands')%>"><%-ni('errands')%>المشاوير</a><%}%></details>
<details class="nav-group" open><summary>العملاء والعلاقات</summary><%if(cm('clients')&&can('clients.directory')){%><a href="<%=adminPath%>/clients" class="<%=on(adminPath+'/clients')%>"><%-ni('clients')%>العملاء والشركات</a><%}%><%if(cm('content')&&can('social.manage')){%><a href="<%=adminPath%>/social" class="<%=on(adminPath+'/social')%>"><%-ni('social')%>حسابات التواصل</a><%}%></details>
<details class="nav-group" open><summary>الموظفون</summary><%if(cm('employees')&&(can('users.view')||can('users.manage'))){%><a href="<%=adminPath%>/users" class="<%=on(adminPath+'/users')%>"><%-ni('users')%>الموظفون</a><%}%><%if(cm('performance')&&can('performance.view')){%><a href="<%=adminPath%>/performance" class="<%=on(adminPath+'/performance')%>"><%-ni('performance')%>تقييم الموظفين</a><%}%><%if(cm('payroll')&&(can('payroll.view_own')||can('payroll.view_all'))){%><a href="<%=adminPath%>/payroll" class="<%=on(adminPath+'/payroll')%>"><%-ni('payroll')%>المرتبات والمكافآت</a><%}%><%if(cm('expenses')&&can('expenses.custody')){%><a href="<%=adminPath%>/expenses/custodies" class="<%=on(adminPath+'/expenses/custodies')%>"><%-ni('custody')%>عهد الموظفين</a><%}%></details>
<details class="nav-group" open><summary>الإدارة المالية</summary><%if(cm('treasury')&&can('treasury.view')){%><a href="<%=adminPath%>/treasury" class="<%=on(adminPath+'/treasury')%>"><%-ni('treasury')%>الخزنة</a><%}%><%if(cm('revenue')&&can('revenue.view')){%><a href="<%=adminPath%>/revenue" class="<%=on(adminPath+'/revenue')%>"><%-ni('revenue')%>الإيرادات</a><%}%><%if(cm('expenses')&&can('expenses.view_all')){%><a href="<%=adminPath%>/expenses" class="<%=on(adminPath+'/expenses')%>"><%-ni('expenses')%>المصروفات</a><%}%></details>
<%if(can('imports.manage')||can('content.manage')||can('security.view')||can('activity.view')||can('settings.manage')||can('report_profiles.manage')||can('trash.restore')){%><details class="nav-group" <%=path.startsWith(adminPath+'/imports')?'open':''%>><summary>الإعدادات والإدارة</summary><%if(can('imports.manage')&&cm('imports')){%><a href="<%=adminPath%>/imports" class="<%=on(adminPath+'/imports')%>"><%-ni('imports')%>استيراد البيانات</a><%}%><%if(cm('content')&&can('content.manage')){%><a href="<%=adminPath%>/homepage" class="<%=on(adminPath+'/homepage')%>"><%-ni('homepage')%>محتوى الرئيسية</a><a href="<%=adminPath%>/content" class="<%=on(adminPath+'/content')%>"><%-ni('content')%>الأقسام والخدمات</a><%}%><%if(cm('security')&&can('security.view')){%><a href="<%=adminPath%>/security" class="<%=on(adminPath+'/security')%>"><%-ni('security')%>الأمان والدخول</a><%}%><%if(cm('security')&&can('activity.view')){%><a href="<%=adminPath%>/activity" class="<%=on(adminPath+'/activity')%>"><%-ni('activity')%>سجل النشاط</a><%}%><%if(cm('reports')&&can('report_profiles.manage')){%><a href="<%=adminPath%>/report-profiles" class="<%=on(adminPath+'/report-profiles')%>"><%-ni('reports')%>هوية التقارير</a><%}%><%if(cm('settings')&&can('settings.manage')){%><a href="<%=adminPath%>/settings" class="<%=on(adminPath+'/settings')%>"><%-ni('settings')%>الإعدادات</a><%}%><%if(cm('settings')&&can('trash.restore')){%><a href="<%=adminPath%>/trash" class="<%=on(adminPath+'/trash')%>"><%-ni('trash')%>سلة المحذوفات</a><%}%><%if(cm('consultations')&&can('content.manage')){%><a href="<%=adminPath%>/consultations-admin" class="<%=on(adminPath+'/consultations-admin')%>"><%-ni('consult')%>إعدادات الاستشارات</a><%}%></details><%}%>
</nav><div class="sidebar-foot"><div class="me"><b><%=user.display_name||user.username%></b><span><%=roleLabel%></span></div><a href="<%=adminPath%>/account" class="btn ghost sm block" style="margin-bottom:8px">حسابي وكلمة المرور</a><form method="post" action="<%=adminPath%>/logout"><%-csrfField%><button class="btn sm block" style="background:transparent;border-color:rgba(255,255,255,.2);color:#c6d2d5">تسجيل الخروج</button></form></div></aside><main class="main"><div class="main-inner">
