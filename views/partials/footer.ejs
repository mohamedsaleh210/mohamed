<footer class="site-foot">
  <div class="wrap foot-grid">
    <div class="foot-about">
      <div class="brand" style="align-items:flex-start">
      <span class="seal"><span>س</span></span>
      <span>
        <b><%= lang==='ar' ? site.name_ar : site.name_en %></b>
        <small style="color:#9fb0b5"><%= lang==='ar' ? site.tagline_ar : site.tagline_en %></small>
      </span>
      </div>
      <p><%= lang==='ar' ? 'منصة مصرية للخدمات القانونية والإدارية، تربط العميل بمقدم الخدمة وتوثق رحلة العمل حتى الإنجاز.' : 'An Egyptian platform for legal and administrative services, connecting the client with the service provider and documenting the work journey through to completion.' %></p>
    </div>
    <div class="foot-column"><b><%= lang==='ar' ? 'الخدمات' : 'Services' %></b><a href="/services"><%= lang==='ar' ? 'جميع الخدمات' : 'All services' %></a><%menuPages.slice(0,4).forEach(p=>{%><a href="/p/<%=p.slug%>"><%= lang==='ar' ? p.name_ar : (p.name_en||p.name_ar) %></a><%})%></div>
    <div class="foot-column"><b><%= lang==='ar' ? 'المنصة' : 'Platform' %></b><a href="/track"><%= lang==='ar' ? 'تتبّع طلب' : 'Track a request' %></a><a href="/guides"><%= lang==='ar' ? 'دليل الاستخدام' : 'User guide' %></a><a href="/faq"><%= lang==='ar' ? 'الأسئلة الشائعة' : 'FAQ' %></a><a href="/support"><%= lang==='ar' ? 'الدعم الفني' : 'Technical support' %></a></div>
    <div class="foot-column"><b><%= lang==='ar' ? 'تواصل معنا' : 'Contact us' %></b><%if(site.whatsapp){%><a dir="ltr" href="<%=waLink(site.whatsapp, lang==='ar' ? 'مرحباً' : 'Hello')%>"><%=site.whatsapp%></a><%}%><%if(site.email){%><a dir="ltr" href="mailto:<%=site.email%>"><%=site.email%></a><%}%><a href="/contact"><%= lang==='ar' ? 'مواعيد وطرق التواصل' : 'Hours & contact methods' %></a>
    <% if (socialLinks.length) { %>
        <div class="foot-social-title"><%= t.follow_us %></div>
        <div class="foot-social">
          <% socialLinks.forEach(l => { %>
            <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"
               aria-label="<%= l.label || l.meta.ar %>" title="<%= l.label || l.meta.ar %>"
               style="--brand:<%= l.meta.color %>">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="<%= l.meta.icon %>"/></svg>
            </a>
          <% }) %>
        </div>
    <% } %>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <span>© <%= new Date().getFullYear() %> <%= lang==='ar' ? site.name_ar : site.name_en %> — <%= t.footer_rights %></span>
  </div>
</footer>

<% if (site.whatsapp) { %>
<a class="wa-float" href="<%= waLink(site.whatsapp, lang==='ar' ? 'مرحباً، أرغب في الاستفسار عن خدماتكم' : 'Hello, I would like to ask about your services') %>" target="_blank" rel="noopener">
