<script src="/js/site.js" defer></script>
<script>
  (function () {
    // Server-rendered .form-alert banners had no ARIA role, so screen
    // readers never announced them. Only sets an attribute on markup the
    // server already rendered — no change to error text or form behavior.
    document.querySelectorAll('.form-alert').forEach(function (el) {
      if (!el.hasAttribute('role')) el.setAttribute('role', 'alert');
    });
  })();
  (function () {
    var nav = document.getElementById('nav');
    var btn = document.getElementById('menuBtn');
    var close = document.getElementById('mobileNavClose');
    var scrim = document.getElementById('mobileNavScrim');
    var returnFocus = null;
    var savedScrollY = 0;
    if (!btn || !nav) return;
    function focusables() {
      return Array.prototype.slice.call(nav.querySelectorAll('a[href],button:not([disabled]),summary,[tabindex]:not([tabindex="-1"])'))
        .filter(function (el) { return el.offsetParent !== null; });
    }
    function setOpen(open) {
      if (open) { returnFocus = document.activeElement; savedScrollY = window.scrollY || 0; document.body.style.top = '-' + savedScrollY + 'px'; }
      nav.classList.toggle('open', open);
      document.body.classList.toggle('mobile-nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.setAttribute('aria-hidden', open ? 'false' : (window.innerWidth <= 1180 ? 'true' : 'false'));
      if (scrim) { scrim.hidden = !open; scrim.classList.toggle('show', open); }
      if (!open) nav.querySelectorAll('details[open]').forEach(function (d) { d.removeAttribute('open'); });
      if (open) window.setTimeout(function () { var f = focusables(); if (f[0]) f[0].focus(); }, 30);
      else { document.body.style.top = ''; window.scrollTo(0, savedScrollY); if (returnFocus && returnFocus.focus) returnFocus.focus(); }
    }
    btn.addEventListener('click', function () { setOpen(!nav.classList.contains('open')); });
    if (close) close.addEventListener('click', function () { setOpen(false); });
    if (scrim) scrim.addEventListener('click', function () { setOpen(false); });
    nav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
      if (e.key === 'Tab' && nav.classList.contains('open')) {
        var f = focusables(); if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      }
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1180) { setOpen(false); nav.setAttribute('aria-hidden', 'false'); }
      else if (!nav.classList.contains('open')) nav.setAttribute('aria-hidden', 'true');
    });
    nav.setAttribute('aria-hidden', window.innerWidth <= 1180 ? 'true' : 'false');
  })();
</script>
</body>
</html>
