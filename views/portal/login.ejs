<% pageTitle = T.login %>
<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="wrap">

    <p class="crumb-home">
      <a href="/">&larr; <%= lang === 'ar' ? 'الرئيسية' : 'Home' %></a>
    </p>

    <div class="form-card" style="max-width:430px">
      <h2 style="text-align:center;color:var(--ink);margin:0 0 6px"><%= T.login %></h2>
      <p style="text-align:center;color:var(--muted);margin:0 0 22px;font-size:14.5px"><%= T.loginSub %></p>

      <% if (query.msg === 'reset_done') { %>
        <div class="notice-ok"><%= T.resetDone %></div>
      <% } %>
      <% if (typeof err !== 'undefined' && err) {
           const errors = {
             google_off: T.googleOff,
             google_failed: T.googleFailed,
             google_state: T.googleFailed,
             google_cancelled: T.googleCancelled,
           };
           if (errors[err]) { %>
        <div class="form-alert"><%= errors[err] %></div>
      <% } } %>
      <% if (error) { %><div class="form-alert"><%= error %></div><% } %>

      <% if (typeof googleOn !== 'undefined' && googleOn) { %>
        <a class="btn google block" href="/portal/google<%= next ? '?next=' + encodeURIComponent(next) : '' %>">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/>
            <path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3a12 12 0 0 0 10.2 6.3z"/>
            <path fill="#FBBC05" d="M5.6 14.7a7.2 7.2 0 0 1 0-4.6v-3H1.8a12 12 0 0 0 0 10.6l3.8-3z"/>
            <path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.6 11.6 0 0 0 12 0 12 12 0 0 0 1.8 6.1l3.8 3C6.5 6.7 9 4.8 12 4.8z"/>
          </svg>
          <%= T.googleBtn %>
        </a>
        <div class="or-split"><span><%= T.googleOr %></span></div>
      <% } %>

      <form method="post" action="/portal/login">
        <% if (typeof next !== "undefined" && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
        <%- csrfField %>
        <div class="field">
          <label for="email"><%= T.email %></label>
          <input id="email" name="email" type="email" required dir="ltr" autocomplete="email">
        </div>
        <div class="field">
          <label for="password"><%= T.password %></label>
          <input id="password" name="password" type="password" required dir="ltr" autocomplete="current-password">
        </div>
        <button class="btn brass block" type="submit"><%= T.submit %></button>
      </form>

      <p style="text-align:center;margin:16px 0 0">
        <a href="/portal/forgot" style="color:var(--brass-deep);font-size:14px;font-weight:700">
          <%= T.forgot %>
        </a>
      </p>

      <p style="text-align:center;margin:18px 0 0;color:var(--muted);font-size:14.5px">
        <%= T.noAccount %>
        <a href="/portal/register" style="color:var(--brass-deep);font-weight:700"><%= T.createOne %></a>
      </p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
