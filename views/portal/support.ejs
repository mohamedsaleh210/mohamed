<%pageTitle='تذاكر الدعم الفني'%><%-include('../partials/head')%><%-include('../partials/header')%><main><section class="section"><div class="wrap"><div class="page-head-row"><div><h1>تذاكر الدعم الفني</h1><p>تابع الردود والحالة حتى الحل.</p></div><a class="btn brass" href="/support">فتح تذكرة جديدة</a></div><div class="panel"><div class="panel-body flush"><table class="tbl"><thead><tr><th>الرقم</th><th>العنوان</th><th>الحالة</th><th>التاريخ</th></tr></thead><tbody><%rows.forEach(t=>{%><tr><td><a href="/support/my/<%=t.id%>"><b><%=t.ref%></b></a></td><td><a href="/support/my/<%=t.id%>"><%=t.title%></a></td><td><%=STATUSES[t.status]%></td><td><%=fmtDate(t.created_at)%></td></tr><%})%></tbody></table><%if(!rows.length){%><div class="empty"><p>لا توجد تذاكر سابقة.</p></div><%}%></div></div></div></section></main><%-include('../partials/footer')%>
