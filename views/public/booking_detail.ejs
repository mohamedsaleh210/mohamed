<%const bookingStatus={unassigned:'يحتاج تعيين',confirmed:'مؤكد',completed:'مغلق',cancelled:'ملغى'};%><%pageTitle='تفاصيل الموعد'%><%-include('../partials/head')%><%-include('../partials/header')%><main><section class="section"><div class="wrap narrow"><div class="panel panel-body"><h1><%=item.ref%></h1><p><b><%=slot.starts_at%> — <%=slot.ends_at%> UTC</b> — <%=slot.location%></p><span class="chip"><%=bookingStatus[item.status]||item.status%></span><p><%=item.notes%></p><%if(!guest){%><a class="btn" href="/portal/requests/<%=item.request_id%>">الطلب والمستندات والمالية</a><%}%><a class="btn" href="/upload/<%=item.request_id%>?t=<%=encodeURIComponent(request.upload_token)%>">إرفاق مستندات</a><%if(!['completed','cancelled'].includes(item.status)){%><form method="post" class="form-grid"><%-csrfField%><input type="hidden" name="version" value="<%=item.version%>"><label>الإجراء<select name="action"><option value="reschedule">إعادة الجدولة</option><option value="cancel">إلغاء الموعد</option></select></label><label>الموعد الجديد<select name="slot_id"><%slots.forEach(s=>{%><option value="<%=s.id%>"><%=s.starts_at%></option><%})%></select></label><label>السبب<input type="text" name="reason" required maxlength="500"></label><button class="btn brass">تنفيذ</button></form><%}%><%if(invoice&&!guest){%><a class="btn" href="/appointments/mine/<%=item.id%>/invoice">عرض الفاتورة</a><%}%><h2>تحديثات الموعد</h2><%updates.forEach(n=>{%><p><%=n.created_at%> — <%=n.text%></p><%})%></div></div></section></main><%-include('../partials/footer')%>
