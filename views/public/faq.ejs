<% pageTitle='الأسئلة الشائعة' %><%-include('../partials/head')%><%-include('../partials/header')%>
<section class="system-hero compact"><div class="wrap"><div class="eyebrow">مركز المساعدة</div><h1>الأسئلة الشائعة</h1><p>إجابات واضحة عن التسجيل وطلب الخدمات واستخدام منصة سند.</p></div></section>
<section class="section"><div class="wrap narrow"><%[
['كيف أسجل حسابًا جديدًا؟','افتح صفحة الدخول واختر إنشاء حساب، ثم أدخل بياناتك وفعّل البريد الإلكتروني. ويمكنك تقديم طلب أولًا ثم إنشاء الحساب لمتابعته.'],
['ما مميزات استخدام الموقع؟','متابعة حالة الطلب، رفع وتنزيل الملفات، معرفة الإجراءات والمواعيد، الاطلاع على الدفعات والفواتير، واستلام الإشعارات والتقييم بعد الإغلاق.'],
['هل يمكن تقديم طلب دون حساب؟','نعم، ويمكنك تتبعه بالرقم المرجعي، لكن الحساب يمنحك سجلًا كاملًا وملفات وفواتير وإشعارات في مكان واحد.'],
['كيف أتابع طلبي؟','من حساب العميل عبر طلباتي، أو من صفحة تتبع الطلب باستخدام الرقم المرجعي وبيانات التحقق.'],
['هل تظهر بياناتي لمستخدمين آخرين؟','لا. نظام الصلاحيات يعرض لكل عميل وموظف فقط البيانات والوظائف المسموح بها.'],
['متى أستطيع إرسال تقييم؟','بعد إغلاق الطلب بنجاح يظهر نموذج التقييم الإلكتروني تلقائيًا.'],
['كيف أفتح تذكرة دعم فني؟','من تبويب الدعم الفني داخل حسابك، ويمكن ربط التذكرة بالطلب المعني لتسريع المعالجة.']
].forEach((x,i)=>{%><details class="faq-item" <%=i===0?'open':''%>><summary><%=x[0]%></summary><p><%=x[1]%></p></details><%})%></div></section>
