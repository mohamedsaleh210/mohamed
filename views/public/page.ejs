<% pageTitle = lang === 'ar' ? page.name_ar : page.name_en %>
<%- include('../partials/head') %>
<%- include('../partials/header') %><main>

<%
  const ar = lang === 'ar';
  const name = ar ? page.name_ar : page.name_en;
  const tagline = ar ? page.tagline_ar : (page.tagline_en || page.tagline_ar);
  const intro = ar ? page.intro_ar : (page.intro_en || page.intro_ar);
%>

<section class="page-banner" style="--page: <%= page.colour %>">
  <div class="wrap">
    <nav class="crumbs on-dark">
      <a href="/"><%= ar ? 'الرئيسية' : 'Home' %></a>
      <span><%= dir === 'rtl' ? '‹' : '›' %></span>
      <strong><%= name %></strong>
    </nav>

    <h1><%= name %></h1>
    <% if (tagline) { %><p class="pb-tag"><%= tagline %></p><% } %>
    <% if (intro) { %><p class="pb-intro"><%= intro %></p><% } %>

    <div class="pb-actions">
      <a class="btn brass" href="/request?page=<%= page.id %>"><%= t.hero_cta %></a>
      <a class="btn ghost-light" href="/contact"><%= ar ? 'اتصل بنا' : 'Contact us' %></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <% if (categories.length) { %>
      <div class="section-head" style="text-align:start;margin-bottom:22px">
        <h2><%= ar ? 'الأقسام' : 'Categories' %></h2>
      </div>

      <div class="cat-grid">
        <% categories.forEach(c => { %>
          <a class="cat-card" href="/services/<%= c.id %>" style="--page: <%= page.colour %>">
            <div class="cat-card-top">
              <h3><%= ar ? c.name_ar : (c.name_en || c.name_ar) %></h3>
              <span class="cat-count" style="background:<%= page.colour %>">
                <%= c.service_count %> <%= ar ? 'خدمة' : 'services' %>
              </span>
            </div>
            <% const desc = ar ? c.desc_ar : (c.desc_en || c.desc_ar); %>
            <% if (desc) { %><p class="cat-card-desc"><%= desc %></p><% } %>
            <span class="cat-card-go" style="color:<%= page.colour %>">
              <%= ar ? 'عرض الخدمات' : 'View services' %>
              <%= dir === 'rtl' ? '←' : '→' %>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>
          <%= ar
            ? 'الصفحة دي لسه بتتجهّز. تواصل معنا وهنساعدك.'
            : 'This section is being prepared. Get in touch and we will help.' %>
        </p>
        <a class="btn brass" href="/contact"><%= ar ? 'اتصل بنا' : 'Contact us' %></a>
      </div>
    <% } %>
  </div>
</section>

</main><%- include('../partials/footer') %>
