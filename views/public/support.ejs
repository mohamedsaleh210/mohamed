<%pageTitle='الدعم الفني'%><%-include('../partials/head')%><%-include('../partials/header')%><main><section class="section"><div class="wrap narrow"><div class="section-head"><h1>الدعم الفني</h1><p>افتح تذكرة وسنتابعها معك حتى الحل والإغلاق.</p></div><%if(sent){%><div class="success-card"><h2>تم فتح التذكرة</h2><p>رقم المتابعة: <b><%=sent%></b></p><%if(clientUser){%><a class="btn brass" href="/support/my">متابعة تذاكري</a><%}else{%><a class="btn brass" href="/portal/register">إنشاء حساب للمتابعة</a><%}%></div><%}else{%><form class="request-form" method="post" enctype="multipart/form-data"><%-csrfField%><div class="form-grid"><label>الاسم<input type="text" name="name" value="<%=clientUser?.full_name||''%>" required></label><label>البريد الإلكتروني<input type="email" name="email" value="<%=clientUser?.email||''%>" required></label><label>رقم الموبايل<input type="text" name="phone" required></label><label>نوع المشكلة<select name="issue_type"><option>مشكلة تقنية</option><option>مشكلة في الحساب</option><option>طلب أو خدمة</option><option>اشتراك أو فاتورة</option><option>أخرى</option></select></label><label>الأولوية<select name="priority"><option value="low">منخفضة</option><option value="medium" selected>متوسطة</option><option value="high">عالية</option><option value="urgent">عاجلة</option></select></label><label>رقم الطلب المرتبط اختياري<input type="text" name="request_id" inputmode="numeric"></label></div><label>عنوان المشكلة<input type="text" name="title" required></label><label>شرح المشكلة<textarea name="description" required></textarea></label><label>صورة أو ملف PDF<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,application/pdf"></label><button class="btn brass">فتح تذكرة جديدة</button></form><%}%></div></section></main><%-include('../partials/footer')%>
